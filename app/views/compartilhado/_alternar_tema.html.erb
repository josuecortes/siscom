<button type="button" data-controller="tema" data-action="tema#alternar"
        class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-[var(--border-subtle)] bg-[var(--surface-card)] text-[var(--text-secondary)] shadow-sm hover:text-[var(--text-primary)]"
        aria-label="Alternar tema" title="Alternar tema">
  <span class="dark:hidden"><%= icone(:moon, classe: "h-[18px] w-[18px]") %></span>
  <span class="hidden dark:inline"><%= icone(:sun, classe: "h-[18px] w-[18px]") %></span>
</button>
