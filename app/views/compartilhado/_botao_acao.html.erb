<%# Botão de ação de linha, só com ícone, 36×36 (porta de ActionIconButton).
    locals: titulo, icone, e UM destes:
      caminho + quadro  -> link que abre num turbo-frame (ex.: "painel")
      caminho + metodo  -> button_to (com confirmar: { mensagem:, rotulo:, tom: } opcional)
    desabilitado: true mostra o botão apagado. Sem `quadro`, usa "_top". perigo: true pinta de vermelho (cancelar, excluir). %>
<%# Fora de um quadro específico, a ação vale para a página inteira (mesmo dentro de um turbo-frame de listagem). %>
<% quadro = local_assigns[:quadro] || "_top" %>
<% classe = "inline-flex h-9 w-9 items-center justify-center rounded-md border border-[var(--border-subtle)] #{local_assigns[:perigo] ? "text-[var(--danger-text)]" : "text-[var(--text-secondary)]"}" %>
<% if local_assigns[:desabilitado] %>
  <span class="<%= classe %> cursor-not-allowed opacity-50" title="<%= titulo %>" aria-label="<%= titulo %>" aria-disabled="true"><%= icone(icone) %></span>
<% elsif local_assigns[:metodo] %>
  <% confirmar = local_assigns[:confirmar] %>
  <%= button_to caminho, method: metodo, title: titulo, aria: { label: titulo },
        class: "#{classe} cursor-pointer hover:bg-[var(--surface-subtle)]",
        form: { class: "inline-flex", data: { turbo_frame: quadro } },
        data: (confirmar ? { turbo_confirm: confirmar[:mensagem], confirmacao_titulo: titulo,
                             confirmacao_rotulo: confirmar[:rotulo] || titulo, confirmacao_tom: confirmar[:tom] || "perigo" } : {}) do %>
    <%= icone(icone) %>
  <% end %>
<% else %>
  <%= link_to caminho, title: titulo, aria: { label: titulo }, class: "#{classe} hover:bg-[var(--surface-subtle)]",
        data: { turbo_frame: quadro } do %>
    <%= icone(icone) %>
  <% end %>
<% end %>
