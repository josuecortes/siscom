<%# Campo de senha com rótulo, erro por campo (borda vermelha + mensagem) e botão de mostrar. %>
<% erros = f.object.errors[campo] %>
<div class="space-y-1.5" data-controller="mostrar-senha">
  <%= f.label campo, rotulo, class: "text-sm font-medium text-[var(--text-secondary)]" %>
  <div class="flex h-11 items-center overflow-hidden rounded-xl border bg-[var(--filter-field-bg)] focus-within:border-[var(--accent-strong)] <%= erros.any? ? "border-[var(--danger-border-strong)]" : "border-[var(--border-subtle)]" %>">
    <%= f.password_field campo, required: true, autocomplete: autocomplete, value: nil,
          aria: { invalid: erros.any?, describedby: (erros.any? ? "erro_#{campo}" : nil) },
          data: { mostrar_senha_target: "campo" },
          class: "h-full w-full bg-transparent px-3 text-sm text-[var(--text-primary)] outline-none" %>
    <button type="button" data-action="mostrar-senha#alternar" data-mostrar-senha-target="botao"
            class="inline-flex h-full w-11 shrink-0 items-center justify-center text-[var(--text-muted)] hover:text-[var(--text-primary)]"
            aria-label="Visualizar senha" title="Visualizar senha">
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M1.5 12s3.8-6 10.5-6 10.5 6 10.5 6-3.8 6-10.5 6S1.5 12 1.5 12Z" />
        <circle cx="12" cy="12" r="3.2" />
        <path data-mostrar-senha-target="risco" class="hidden" d="M3 3l18 18" />
      </svg>
    </button>
  </div>
  <% if erros.any? %>
    <p id="erro_<%= campo %>" class="text-xs text-[var(--danger-text)]"><%= f.object.class.human_attribute_name(campo) %> <%= erros.first %></p>
  <% end %>
</div>
