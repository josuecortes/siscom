<%# Diálogo de confirmação (porta de confirm-dialog.tsx). Fica oculto no layout e é aberto
    por app/javascript/confirmacao.js quando um formulário/botão tem data-turbo-confirm:
      button_to "...", caminho, method: :patch,
        data: { turbo_confirm: "Confirme a desativação do usuário X.",
                confirmacao_titulo: "Desativar usuário", confirmacao_rotulo: "Desativar usuário",
                confirmacao_tom: "perigo" }   # ou "primario" %>
<div id="confirmacao" hidden class="fixed inset-0 z-[85] overflow-hidden overscroll-none">
  <button type="button" data-confirmacao="cancelar" class="absolute inset-0 cursor-pointer bg-[#08111fcc]" aria-label="Fechar confirmação" tabindex="-1"></button>

  <div class="pointer-events-none relative flex h-[100svh] min-h-[100svh] w-full items-stretch justify-end overflow-hidden p-0 sm:min-h-full sm:p-4 lg:items-center lg:justify-center lg:p-6">
    <div role="alertdialog" aria-modal="true" aria-labelledby="confirmacao_titulo" aria-describedby="confirmacao_descricao"
         class="pointer-events-auto flex h-[100svh] w-[min(92vw,34rem)] max-w-[92vw] flex-col overflow-hidden border-l border-[var(--border-subtle)] bg-[var(--surface-card)] shadow-[0_24px_70px_rgba(2,6,23,0.35)] sm:h-[100dvh] sm:w-full sm:max-w-[34rem] lg:h-auto lg:max-h-[calc(100dvh-3rem)] lg:w-[min(92vw,34rem)] lg:max-w-none lg:rounded-[var(--radius-panel)] lg:border">
      <div class="shrink-0 border-b border-[var(--border-subtle)] px-5 py-4">
        <div class="flex items-center justify-between gap-4">
          <div>
            <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[var(--text-muted)]">Confirmação</p>
            <h2 id="confirmacao_titulo" class="mt-1 text-xl font-semibold text-[var(--text-primary)]"></h2>
          </div>
          <button type="button" data-confirmacao="cancelar"
                  class="inline-flex h-9 w-9 cursor-pointer items-center justify-center rounded-md border border-[var(--border-subtle)] text-[var(--text-secondary)] hover:bg-[var(--surface-subtle)]"
                  aria-label="Fechar">×</button>
        </div>
      </div>

      <%# O seed monta a confirmação com o painel de formulário e um miolo vazio: daí o espaço de 20 px depois da descrição. %>
      <div class="min-h-0 flex-1 space-y-5 overflow-y-auto px-5 py-5">
        <p id="confirmacao_descricao" class="text-sm leading-6 text-[var(--text-secondary)]"></p>
        <div></div>
      </div>

      <div class="shrink-0 border-t border-[var(--border-subtle)] bg-[var(--surface-card)] px-5 py-4">
        <div class="flex flex-col gap-2 sm:flex-row sm:justify-end">
          <button type="button" data-confirmacao="cancelar"
                  class="inline-flex h-10 cursor-pointer items-center justify-center rounded-md border border-[var(--border-subtle)] px-4 text-sm font-semibold text-[var(--text-secondary)] hover:bg-[var(--surface-subtle)]">Cancelar</button>
          <button type="button" data-confirmacao="confirmar"
                  class="inline-flex h-10 cursor-pointer items-center justify-center rounded-md bg-[var(--danger-solid)] px-4 text-sm font-semibold text-white hover:bg-[var(--danger-solid-hover)] data-[tom=primario]:bg-[var(--accent-strong)] data-[tom=primario]:hover:bg-[var(--accent-stronger)]">Confirmar</button>
        </div>
      </div>
    </div>
  </div>
</div>
