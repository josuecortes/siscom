<%# Filtro padrão das listagens: busca + status + botões (lado a lado, também no celular).
    locals: url, quadro (turbo-frame da lista), rotulo_busca, exemplo, busca, status,
            opcoes_status ([[rotulo, valor]]), titulo_filtrar,
            grade (opcional: classe das colunas em telas largas; padrão "lg:grid-cols-[1.2fr_0.5fr_auto]") %>
<% campo = "h-11 w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] text-sm outline-none focus:border-[var(--accent-strong)]" %>
<%= form_with url: url, method: :get, class: "border-b border-[var(--border-subtle)] px-6 py-5",
      data: { controller: "filtro", turbo_frame: quadro, turbo_action: "advance" } do |f| %>
  <div class="grid gap-4 <%= local_assigns[:grade] || "lg:grid-cols-[1.2fr_0.5fr_auto]" %> lg:items-end">
    <div class="space-y-1.5">
      <%= f.label :q, rotulo_busca, class: "text-sm font-medium text-[var(--text-secondary)]" %>
      <div class="relative">
        <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-[var(--text-muted)]"><%= icone(:search) %></span>
        <%= f.text_field :q, value: busca, placeholder: exemplo, autocomplete: "off", data: { action: "input->filtro#digitar" }, class: "#{campo} pl-11 pr-4" %>
      </div>
    </div>
    <div class="space-y-1.5">
      <%= f.label :status, "Status", class: "text-sm font-medium text-[var(--text-secondary)]" %>
      <%= f.select :status, opcoes_status, { selected: status }, data: { action: "change->filtro#aplicar" }, class: "#{campo} px-4" %>
    </div>
    <div class="flex flex-row gap-2">
      <button type="submit" title="<%= titulo_filtrar %>" aria-label="<%= titulo_filtrar %>"
              class="inline-flex h-11 w-11 cursor-pointer items-center justify-center rounded-xl bg-[var(--accent-strong)] text-white hover:bg-[var(--accent-stronger)]"><%= icone(:search) %></button>
      <%= link_to url, title: "Limpar filtros", aria: { label: "Limpar filtros" },
            class: "inline-flex h-11 w-11 items-center justify-center rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] text-[var(--text-secondary)] hover:border-[var(--accent-strong)]" do %>
        <%= icone(:x) %>
      <% end %>
    </div>
  </div>
<% end %>
