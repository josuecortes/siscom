<%# Paginação do seed: "Página X de Y" + Anterior/Próxima. locals: pagy (Pagy::Offset), quadro (id do turbo-frame, opcional) %>
<% if pagy.last > 1 %>
  <% classe = "rounded-md border border-[var(--border-subtle)] px-3 py-2 text-sm font-medium text-[var(--text-secondary)]" %>
  <% dados = { turbo_frame: local_assigns[:quadro], turbo_action: "advance" }.compact %>
  <nav aria-label="Paginação" class="flex items-center justify-between border-t border-[var(--border-subtle)] px-6 py-4">
    <p class="text-sm text-[var(--text-secondary)]">Página <%= pagy.page %> de <%= pagy.last %></p>
    <div class="flex items-center gap-2">
      <% if pagy.previous %>
        <%= link_to "Anterior", url_for(request.query_parameters.merge(page: pagy.previous)), class: "#{classe} hover:bg-[var(--surface-subtle)]", data: dados, rel: "prev" %>
      <% else %>
        <span class="<%= classe %> cursor-not-allowed opacity-50" aria-disabled="true">Anterior</span>
      <% end %>
      <% if pagy.next %>
        <%= link_to "Próxima", url_for(request.query_parameters.merge(page: pagy.next)), class: "#{classe} hover:bg-[var(--surface-subtle)]", data: dados, rel: "next" %>
      <% else %>
        <span class="<%= classe %> cursor-not-allowed opacity-50" aria-disabled="true">Próxima</span>
      <% end %>
    </div>
  </nav>
<% end %>
