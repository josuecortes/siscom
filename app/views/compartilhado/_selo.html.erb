<%# Selo (badge). locals: texto, tom (:sucesso, :atencao, :info, :neutro), maiusculo (bool) %>
<% tons = { sucesso: "bg-[var(--success-badge-surface)] text-[var(--success-badge-text)]",
            atencao: "bg-[var(--warning-surface)] text-[var(--warning-text)]",
            info: "bg-[var(--info-badge-surface)] text-[var(--info-badge-text)]",
            neutro: "bg-[var(--surface-subtle)] text-[var(--text-secondary)]" } %>
<span class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold <%= tons.fetch(local_assigns.fetch(:tom, :neutro)) %> <%= "uppercase tracking-[0.08em]" if local_assigns[:maiusculo] %>"><%= texto %></span>
