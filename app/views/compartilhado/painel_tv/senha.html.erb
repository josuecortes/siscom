<% content_for :title, "Painel de transporte" %>
<%# Porta da tela de senha de transport-public-tracking-board.tsx (cartão de 36rem, 24 px de respiro), nas cores do tema claro. %>
<div class="w-full px-4 py-10 md:px-0 md:py-0">
  <section class="mx-auto w-full max-w-xl rounded-2xl border border-[var(--border-subtle)] bg-[var(--surface-card)] p-6 shadow-[var(--shadow-card)]">
    <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[var(--text-muted)]">Transporte</p>
    <h1 class="mt-2 text-2xl font-semibold text-[var(--text-primary)]">Acompanhamento em tempo real</h1>
    <p class="mt-2 text-sm text-[var(--text-secondary)]">Informe a senha de acesso para visualizar o painel.</p>
    <%= form_with url: transporte_acompanhamento_path, method: :post, class: "mt-6 space-y-3" do %>
      <% if @erro.present? %>
        <%= render "compartilhado/faixa_aviso", tom: :erro, embutida: true, mensagem: @erro %>
      <% end %>
      <label for="senha" class="sr-only">Senha de acesso</label>
      <%= password_field_tag :senha, nil, required: true, autofocus: true, autocomplete: "off", placeholder: "Senha de acesso",
            class: "h-11 w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] px-4 text-sm text-[var(--text-primary)] outline-none placeholder:text-[var(--text-muted)] focus:border-[var(--accent-strong)]" %>
      <button type="submit" class="inline-flex h-11 w-full cursor-pointer items-center justify-center rounded-xl bg-[var(--accent-strong)] px-5 text-sm font-semibold text-white hover:bg-[var(--accent-stronger)]">Entrar no acompanhamento</button>
    <% end %>
  </section>
</div>
