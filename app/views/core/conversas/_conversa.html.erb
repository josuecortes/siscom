<%# A conversa de um registro, na página dele. locals: conversa (Core::Api.conversa_de(alvo), pode ser nil),
    ver_sem_participar (bool: supervisão lê o histórico sem participar).
    Quem participa conversa pelo ícone flutuante: aqui aparece só o botão que abre o painel nela.
    Quem não participa e não supervisiona não vê nada.
    sem_botao: true esconde o botão de quem participa (no painel de "ver", o botão fica na linha da lista). %>
<% participante = conversa&.participante(current_user) %>
<% if conversa && participante&.pode_ler? && local_assigns[:sem_botao] %>
<% elsif conversa && participante&.pode_ler? %>
  <% nao_lidas = participante.nao_lidas %>
  <section class="flex flex-wrap items-center justify-between gap-3 rounded-[var(--radius-panel)] border border-[var(--border-subtle)] bg-[var(--surface-card)] px-6 py-5 shadow-[var(--shadow-card)]">
    <div>
      <h2 class="flex items-center gap-2 text-sm font-semibold text-[var(--text-primary)]"><%= icone(:chat_bubble) %> Conversa</h2>
      <p class="mt-1 text-sm text-[var(--text-secondary)]">
        <%= conversa.ativa? ? "Fale com quem está cuidando deste chamado." : "Conversa encerrada: fica só para consulta." %>
        <% if nao_lidas.positive? %><strong class="text-[var(--accent-strong)]"><%= nao_lidas %> não lida(s).</strong><% end %>
      </p>
    </div>
    <button type="button" data-action="lancador#abrirConversa" data-lancador-url-param="<%= painel_conversa_path(conversa) %>"
            class="inline-flex h-10 cursor-pointer items-center gap-2 rounded-md bg-[var(--accent-strong)] px-4 text-sm font-semibold text-white hover:bg-[var(--accent-stronger)]"><%= icone(:chat_bubble) %> Abrir conversa</button>
  </section>
<% elsif conversa && local_assigns[:ver_sem_participar] %>
  <section id="<%= dom_id(conversa) %>" data-controller="conversa"
           class="rounded-[var(--radius-panel)] border border-[var(--border-subtle)] bg-[var(--surface-card)] shadow-[var(--shadow-card)]">
    <%= turbo_stream_from conversa %>
    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[var(--border-subtle)] px-6 py-5">
      <h2 class="flex items-center gap-2 text-sm font-semibold text-[var(--text-primary)]"><%= icone(:chat_bubble) %> Conversa (só leitura)</h2>
      <%= render "compartilhado/selo", texto: (conversa.ativa? ? "Aberta" : "Encerrada"), tom: (conversa.ativa? ? :sucesso : :neutro) %>
    </div>
    <ol id="mensagens_da_conversa_<%= conversa.id %>" data-conversa-target="lista" class="max-h-96 space-y-4 overflow-y-auto px-6 py-5">
      <%= render partial: "core/conversas/mensagem", collection: conversa.mensagens.em_ordem, as: :mensagem %>
    </ol>
  </section>
<% end %>
