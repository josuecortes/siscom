<% content_for :title, "Conversas" %>

<%= render layout: "compartilhado/cabecalho_pagina", locals: { titulo: "Conversas", icone: :chat_bubble, migalha: [ "Minha área", conversas_path ] } do %>
<% end %>

<section class="mt-6 rounded-[var(--radius-panel)] border border-[var(--border-subtle)] bg-[var(--surface-card)] shadow-[var(--shadow-card)]">
  <%= render "compartilhado/resumo_tabela", texto: "#{@pagy.count} conversa(s)" %>

  <div class="overflow-x-auto">
    <table class="collection-table min-w-[760px]">
      <thead>
        <tr>
          <th scope="col">Conversa</th>
          <th scope="col">Módulo</th>
          <th scope="col">Última mensagem</th>
          <th scope="col">Situação</th>
          <th scope="col">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% @participacoes.each do |participacao| %>
          <% conversa = participacao.conversa %>
          <% nao_lidas = participacao.nao_lidas %>
          <tr id="<%= dom_id(conversa) %>">
            <td>
              <p class="text-sm font-semibold text-[var(--text-primary)]"><%= conversa.titulo %></p>
              <% if nao_lidas.positive? %><p class="mt-1 text-xs font-semibold text-[var(--accent-strong)]"><%= nao_lidas %> não lida(s)</p><% end %>
            </td>
            <td><%= conversa.nome_do_modulo %></td>
            <td class="whitespace-nowrap"><%= conversa.ultima_mensagem_em ? l(conversa.ultima_mensagem_em, format: "%d/%m/%Y %H:%M") : "—" %></td>
            <td><%= render "compartilhado/selo", texto: (conversa.ativa? ? "Aberta" : "Só leitura"), tom: (conversa.ativa? ? :sucesso : :neutro) %></td>
            <td><%= render "compartilhado/botao_acao", titulo: "Abrir conversa", icone: :chat_bubble, caminho: (participacao.url.presence || conversa_path(conversa)) %></td>
          </tr>
        <% end %>
        <% if @participacoes.empty? %>
          <tr><td colspan="5" class="px-6 py-10 text-center text-sm text-[var(--text-secondary)]">Você ainda não participa de nenhuma conversa. Elas começam quando a TI assume um chamado seu.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= render "compartilhado/paginacao", pagy: @pagy %>
</section>
