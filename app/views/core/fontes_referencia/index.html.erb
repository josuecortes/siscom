<% content_for :title, "Fontes de referência" %>

<%= render layout: "compartilhado/cabecalho_pagina", locals: { titulo: "Fontes de referência", icone: :description, migalha: [ "Administração", core_fontes_referencia_path ] } do %>
  <%= render "compartilhado/acao_cabecalho", rotulo: "Nova fonte", icone: :plus, caminho: new_core_fonte_referencia_path,
        opcoes: { data: { turbo_frame: "painel" } } %>
<% end %>

<section class="mt-6 rounded-[var(--radius-panel)] border border-[var(--border-subtle)] bg-[var(--surface-card)] shadow-[var(--shadow-card)]">
  <%= form_with url: core_fontes_referencia_path, method: :get, class: "border-b border-[var(--border-subtle)] px-6 py-5",
        data: { controller: "filtro", turbo_frame: "fontes_lista", turbo_action: "advance" } do |f| %>
    <div class="grid gap-4 lg:grid-cols-[1fr_auto] lg:items-end">
      <div class="space-y-1.5">
        <%= f.label :q, "Buscar por nome, chave, módulo ou entidade", class: "text-sm font-medium text-[var(--text-secondary)]" %>
        <div class="relative">
          <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-[var(--text-muted)]"><%= icone(:search) %></span>
          <%= f.text_field :q, value: @busca, placeholder: "Ex.: usuários", autocomplete: "off", data: { action: "input->filtro#digitar" },
                class: "h-11 w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] pl-11 pr-4 text-sm outline-none focus:border-[var(--accent-strong)]" %>
        </div>
      </div>
      <div class="flex flex-row gap-2">
        <button type="submit" title="Filtrar fontes" aria-label="Filtrar fontes"
                class="inline-flex h-11 w-11 cursor-pointer items-center justify-center rounded-xl bg-[var(--accent-strong)] text-white hover:bg-[var(--accent-stronger)]"><%= icone(:search) %></button>
        <%= link_to core_fontes_referencia_path, title: "Limpar filtros", aria: { label: "Limpar filtros" },
              class: "inline-flex h-11 w-11 items-center justify-center rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] text-[var(--text-secondary)] hover:border-[var(--accent-strong)]" do %>
          <%= icone(:x) %>
        <% end %>
      </div>
    </div>
  <% end %>

  <%= turbo_frame_tag "fontes_lista", data: { turbo_action: "advance" } do %>
    <%= render "compartilhado/resumo_tabela", texto: "#{@pagy.count} fonte(s) registrada(s)" %>

    <div class="overflow-x-auto">
      <table class="collection-table min-w-[1180px]">
        <thead>
          <tr>
            <th scope="col">Fonte</th>
            <th scope="col">Chave</th>
            <th scope="col">Módulo</th>
            <th scope="col">Entidade</th>
            <th scope="col">Campo visível</th>
            <th scope="col">Campo identificador</th>
            <th scope="col">Tipos suportados</th>
            <th scope="col">Status</th>
            <th scope="col">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% @fontes.each do |fonte| %>
            <tr id="<%= dom_id(fonte) %>">
              <td>
                <p class="text-sm font-semibold text-[var(--text-primary)]"><%= fonte.nome %></p>
                <% if fonte.gerenciada_pelo_sistema? %><p class="text-xs text-[var(--text-muted)]">Gerenciada pelo sistema</p><% end %>
              </td>
              <td><code class="text-sm"><%= fonte.chave %></code></td>
              <td><%= fonte.nome_do_modulo %></td>
              <td><%= fonte.entidade %></td>
              <td><%= fonte.campo_rotulo %></td>
              <td><%= fonte.campo_valor %></td>
              <td><%= fonte.tipos_de_campo.map { |tipo| Core::FonteReferencia::TIPOS_DE_CAMPO[tipo] }.to_sentence %></td>
              <td><%= render "compartilhado/selo", texto: (fonte.ativo? ? "Ativa" : "Inativa"), tom: (fonte.ativo? ? :sucesso : :atencao) %></td>
              <td>
                <div class="flex flex-nowrap items-center gap-2">
                  <%= render "compartilhado/botao_acao", titulo: "Editar fonte", icone: :pencil, caminho: edit_core_fonte_referencia_path(fonte), quadro: "painel" %>
                  <% if fonte.ativo? %>
                    <%= render "compartilhado/botao_acao", titulo: "Desativar fonte", icone: :ban, caminho: desativar_core_fonte_referencia_path(fonte), metodo: :patch,
                          confirmar: { mensagem: "Confirme a desativação da fonte #{fonte.nome}. Os campos que usam esta fonte deixam de oferecer opções.", rotulo: "Desativar" } %>
                  <% else %>
                    <%= render "compartilhado/botao_acao", titulo: "Ativar fonte", icone: :check_circle, caminho: ativar_core_fonte_referencia_path(fonte), metodo: :patch,
                          confirmar: { mensagem: "Confirme a ativação da fonte #{fonte.nome}.", rotulo: "Ativar", tom: "primario" } %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
          <% if @fontes.empty? %>
            <tr><td colspan="9" class="px-6 py-10 text-center text-sm text-[var(--text-secondary)]">Nenhuma fonte encontrada para os filtros informados.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render "compartilhado/paginacao", pagy: @pagy, quadro: "fontes_lista" %>
  <% end %>
</section>
