<% content_for :title, "Usuários" %>

<%= render layout: "compartilhado/cabecalho_pagina", locals: { titulo: "Usuários", icone: :people, migalha: [ "Administração", core_usuarios_path ] } do %>
  <% if policy([ :core, :usuario ]).create? %>
    <%= render "compartilhado/acao_cabecalho", rotulo: "Novo usuário", icone: :plus, caminho: new_core_usuario_path,
          opcoes: { data: { turbo_frame: "painel" } } %>
  <% end %>
<% end %>

<section class="mt-6 rounded-[var(--radius-panel)] border border-[var(--border-subtle)] bg-[var(--surface-card)] shadow-[var(--shadow-card)]">
  <%= form_with url: core_usuarios_path, method: :get, class: "border-b border-[var(--border-subtle)] px-6 py-5",
        data: { controller: "filtro", turbo_frame: "usuarios_lista", turbo_action: "advance" } do |f| %>
    <div class="grid gap-4 lg:grid-cols-[1.2fr_0.5fr_auto] lg:items-end">
      <div class="space-y-1.5">
        <%= f.label :q, "Buscar por nome ou e-mail", class: "text-sm font-medium text-[var(--text-secondary)]" %>
        <div class="relative">
          <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-[var(--text-muted)]"><%= icone(:search) %></span>
          <%= f.search_field :q, value: @filtros[:q], placeholder: "Ex.: João Silva ou joao@seed.ap.gov.br", autocomplete: "off",
                data: { action: "input->filtro#digitar" },
                class: "h-11 w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] pl-11 pr-4 text-sm outline-none focus:border-[var(--accent-strong)]" %>
        </div>
      </div>

      <div class="space-y-1.5">
        <%= f.label :status, "Status", class: "text-sm font-medium text-[var(--text-secondary)]" %>
        <%= f.select :status, [ [ "Todos", "todos" ], [ "Ativos", "ativos" ], [ "Inativos", "inativos" ] ], { selected: @filtros[:status] },
              data: { action: "change->filtro#aplicar" },
              class: "h-11 w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] px-4 text-sm outline-none focus:border-[var(--accent-strong)]" %>
      </div>

      <div class="flex flex-row gap-2">
        <button type="submit" title="Filtrar usuários" aria-label="Filtrar usuários"
                class="inline-flex h-11 w-11 cursor-pointer items-center justify-center rounded-xl bg-[var(--accent-strong)] text-white hover:bg-[var(--accent-stronger)]">
          <%= icone(:search) %>
        </button>
        <%= link_to core_usuarios_path, title: "Limpar filtros", aria: { label: "Limpar filtros" },
              class: "inline-flex h-11 w-11 items-center justify-center rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] text-[var(--text-secondary)] hover:border-[var(--accent-strong)]" do %>
          <%= icone(:x) %>
        <% end %>
      </div>
    </div>
  <% end %>

  <%= turbo_frame_tag "usuarios_lista", data: { turbo_action: "advance" } do %>
    <%= render "compartilhado/resumo_tabela", texto: "#{@pagy.count} usuário(s) #{@filtros[:q].present? || @filtros[:status] != "todos" ? "encontrado(s) para os filtros informados" : "cadastrado(s) no sistema"}" %>

    <div class="overflow-x-auto">
      <table class="collection-table min-w-[960px]">
        <thead>
          <tr>
            <th scope="col">Nome</th>
            <th scope="col">E-mail</th>
            <th scope="col">Status</th>
            <th scope="col">Módulos</th>
            <th scope="col">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% if @usuarios.any? %>
            <%= render partial: "usuario", collection: @usuarios, as: :usuario %>
          <% else %>
            <tr><td colspan="5" class="px-6 py-10 text-center text-sm text-[var(--text-secondary)]">Nenhum usuário encontrado para os filtros informados.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render "compartilhado/paginacao", pagy: @pagy, quadro: "usuarios_lista" %>
  <% end %>
</section>
