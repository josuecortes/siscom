<% content_for :title, "Histórico de equipamentos" %>
<%= render "compartilhado/cabecalho_pagina", titulo: "Histórico", icone: :notes, migalha: [ "Equipamentos", equipamentos_itens_path ] %>

<% campo = "h-11 w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] text-sm text-[var(--text-primary)] outline-none focus:border-[var(--accent-strong)]" %>
<% rotulo = "text-sm font-medium text-[var(--text-secondary)]" %>
<% data = { controller: "mascara", mascara_tipo_value: "data", action: "input->mascara#aplicar" } %>
<section class="mt-6 rounded-[var(--radius-panel)] border border-[var(--border-subtle)] bg-[var(--surface-card)] shadow-[var(--shadow-card)]">
  <%= form_with url: equipamentos_historico_path, method: :get, class: "border-b border-[var(--border-subtle)] px-6 py-5", data: { controller: "filtro", turbo_frame: "historico_lista", turbo_action: "advance" } do |f| %>
    <% extras = @filtros.slice(:tipo, :de, :ate).values.count(&:present?) %>
    <div class="space-y-4" data-controller="recolher">
      <div class="flex items-end gap-2">
        <div class="min-w-0 flex-1 space-y-1.5">
          <%= f.label :q, "Buscar pelo que mudou, por quem fez ou pelo equipamento (marca, serial, patrimônio…)", class: "sr-only md:not-sr-only #{rotulo}" %>
          <div class="relative">
            <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-[var(--text-muted)]"><%= icone(:search) %></span>
            <%= f.text_field :q, value: @filtros[:q], placeholder: "O que mudou, quem fez ou o equipamento", autocomplete: "off", data: { action: "input->filtro#digitar" }, class: "#{campo} pl-11 pr-4" %>
          </div>
        </div>
        <button type="submit" title="Filtrar" aria-label="Filtrar"
                class="inline-flex h-11 w-11 shrink-0 cursor-pointer items-center justify-center rounded-xl bg-[var(--accent-strong)] text-white hover:bg-[var(--accent-stronger)]"><%= icone(:search) %></button>
        <%= link_to equipamentos_historico_path, title: "Limpar filtros", aria: { label: "Limpar filtros" },
              class: "inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] text-[var(--text-secondary)] hover:border-[var(--accent-strong)]" do %>
          <%= icone(:x) %>
        <% end %>
      </div>
      <button type="button" data-recolher-target="botao" data-action="recolher#alternar" aria-expanded="false" aria-controls="mais_filtros"
              class="group inline-flex h-10 w-full cursor-pointer items-center justify-between gap-2 rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] px-4 text-sm font-semibold text-[var(--text-primary)] md:hidden">
        <span class="inline-flex items-center gap-2">
          Mais filtros
          <% if extras.positive? %><span class="inline-flex min-w-[1.5rem] items-center justify-center rounded-full bg-[var(--accent-soft)] px-2 py-0.5 text-[11px] text-[var(--accent-strong)]"><%= extras %></span><% end %>
        </span>
        <span class="text-[var(--text-secondary)] transition-transform group-aria-expanded:rotate-180"><%= icone(:chevron_right, classe: "h-4 w-4 rotate-90") %></span>
      </button>
      <div id="mais_filtros" data-recolher-target="bloco" class="hidden gap-4 md:grid md:grid-cols-3 md:items-end">
        <div class="mb-4 space-y-1.5 md:mb-0">
          <label for="tipo" class="<%= rotulo %>">O que aconteceu</label>
          <%= select_tag :tipo, options_for_select([ [ "Tudo", "" ] ] + Equipamentos::Evento::TIPOS.invert.to_a, @filtros[:tipo]), data: { action: "change->filtro#aplicar" }, class: "#{campo} px-3" %>
        </div>
        <div class="grid grid-cols-2 gap-4 md:contents">
          <div class="space-y-1.5">
            <label for="de" class="<%= rotulo %>">De</label>
            <%= text_field_tag :de, DataBr.formatar(@filtros[:de]), placeholder: "dd/mm/aaaa", inputmode: "numeric", maxlength: 10, autocomplete: "off", data: data, class: "#{campo} px-4" %>
          </div>
          <div class="space-y-1.5">
            <label for="ate" class="<%= rotulo %>">Até</label>
            <%= text_field_tag :ate, DataBr.formatar(@filtros[:ate]), placeholder: "dd/mm/aaaa", inputmode: "numeric", maxlength: 10, autocomplete: "off", data: data, class: "#{campo} px-4" %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <%= turbo_frame_tag "historico_lista", data: { turbo_action: "advance" } do %>
    <%= render "compartilhado/resumo_tabela", texto: "#{@pagy.count} registro(s), do mais recente para o mais antigo" %>
    <div class="overflow-x-auto">
      <table class="collection-table min-w-[960px]">
        <thead>
          <tr>
            <th scope="col">Quando</th>
            <th scope="col">Equipamento</th>
            <th scope="col">O que aconteceu</th>
            <th scope="col">Quem fez</th>
          </tr>
        </thead>
        <tbody>
          <% @eventos.each do |evento| %>
            <tr id="<%= dom_id(evento) %>">
              <td class="whitespace-nowrap align-top"><%= l(evento.ocorrido_em, format: "%d/%m/%Y %H:%M") %></td>
              <td class="!whitespace-normal align-top">
                <%= link_to evento.item.nome, equipamentos_item_path(evento.item), class: "text-sm font-semibold text-[var(--text-primary)] hover:text-[var(--accent-strong)]", data: { turbo_frame: "painel" } %>
                <p class="mt-1 text-xs text-[var(--text-muted)]"><%= evento.item.identificacao %> · <%= evento.item.unidade_nome %></p>
              </td>
              <td class="!whitespace-normal align-top">
                <p class="text-sm font-semibold text-[var(--text-primary)]"><%= evento.titulo %></p>
                <% if evento.nota.present? %><p class="mt-1 break-words text-sm text-[var(--text-secondary)]"><%= evento.nota %></p><% end %>
              </td>
              <td class="!whitespace-normal align-top text-sm text-[var(--text-secondary)]"><%= evento.ator_nome.presence || "Sistema" %></td>
            </tr>
          <% end %>
          <% if @eventos.empty? %>
            <tr><td colspan="4" class="px-6 py-10 text-center text-sm text-[var(--text-secondary)]">Nenhum registro encontrado.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render "compartilhado/paginacao", pagy: @pagy, quadro: "historico_lista" %>
  <% end %>
</section>
