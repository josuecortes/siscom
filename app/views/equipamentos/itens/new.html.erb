<% content_for :title, "Novo equipamento" %>
<% rodape = capture { render "compartilhado/rodape_painel", formulario: "formulario_equipamento", rotulo: "Cadastrar" } %>
<% entrada = "h-11 w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] px-4 text-sm text-[var(--text-primary)] outline-none focus:border-[var(--accent-strong)]" %>
<% rotulo = "text-sm font-medium text-[var(--text-secondary)]" %>
<% kit = (@kit || {}).to_h.symbolize_keys %>

<%= render layout: "compartilhado/painel_formulario",
      locals: { sobretitulo: "Novo equipamento", titulo: "Cadastrar equipamento", voltar: equipamentos_itens_path, largo: true, rodape: rodape,
                descricao: "Um equipamento sozinho, ou um kit: várias peças de uma vez (ex.: gabinete, monitor, teclado e mouse), que recebem o mesmo código de kit." } do %>
  <%= form_with url: equipamentos_itens_path, id: "formulario_equipamento", class: "space-y-5", data: { controller: "mostrar-por-valor" } do |formulario| %>
    <% if @erro.present? || @item.errors.any? %>
      <%= render "compartilhado/faixa_aviso", tom: :erro, embutida: true, mensagem: (@erro || @item.errors[:base].first || "Revise os campos destacados e tente novamente.") %>
    <% end %>
    <div class="space-y-1.5">
      <label for="modo" class="<%= rotulo %>">O que vai cadastrar *</label>
      <%= select_tag :modo, options_for_select([ [ "Um equipamento", "individual" ], [ "Um kit (várias peças)", "kit" ] ], @modo), class: entrada,
            data: { mostrar_por_valor_target: "campo", action: "change->mostrar-por-valor#atualizar" } %>
    </div>

    <div class="space-y-5" data-mostrar-por-valor-target="bloco" data-valores="individual">
      <%= render "unidade", prefixo: "item", valor: @item.rh_unidade_id || params.dig(:item, :rh_unidade_id), todas: @todas, unidades: @unidades %>
      <%= fields_for :item, @item do |f| %>
        <%= render "campos", f: f, sugestoes: @sugestoes %>
      <% end %>
    </div>

    <div class="space-y-5" data-mostrar-por-valor-target="bloco" data-valores="kit">
      <%= render "unidade", prefixo: "kit", valor: kit[:rh_unidade_id], todas: @todas, unidades: @unidades %>
      <div class="space-y-1.5">
        <label for="kit_identificacao_kit" class="<%= rotulo %>">Identificação do kit *</label>
        <%= text_field_tag "kit[identificacao_kit]", kit[:identificacao_kit], id: "kit_identificacao_kit", required: true, maxlength: 80, autocomplete: "off", placeholder: "Ex.: Laboratório 2, mesa 5", class: entrada %>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        <div class="space-y-1.5">
          <label for="kit_contrato" class="<%= rotulo %>">Contrato ou referência</label>
          <%= text_field_tag "kit[contrato]", kit[:contrato], id: "kit_contrato", maxlength: 80, list: "sugestoes_contrato", autocomplete: "off", class: entrada %>
        </div>
        <div class="space-y-1.5">
          <label for="kit_processo" class="<%= rotulo %>">Processo</label>
          <%= text_field_tag "kit[processo]", kit[:processo], id: "kit_processo", maxlength: 80, list: "sugestoes_processo", autocomplete: "off", class: entrada %>
        </div>
      </div>
      <div class="space-y-1.5">
        <label for="kit_descricao" class="<%= rotulo %>">Descrição</label>
        <%= text_area_tag "kit[descricao]", kit[:descricao], id: "kit_descricao", rows: 3, maxlength: 1000,
              class: "min-h-24 w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] px-4 py-3 text-sm text-[var(--text-primary)] outline-none focus:border-[var(--accent-strong)]" %>
      </div>
      <fieldset class="space-y-3" data-controller="lista">
        <legend class="text-sm font-semibold text-[var(--text-primary)]">Peças do kit</legend>
        <p class="text-xs text-[var(--text-muted)]">Cada peça precisa de pelo menos um identificador (patrimônio, serial ou outra identificação).</p>
        <div class="space-y-3" data-lista-target="itens">
          <% @pecas.each_with_index do |peca, indice| %><%= render "peca", peca: peca, indice: indice %><% end %>
        </div>
        <template data-lista-target="modelo"><%= render "peca", peca: Equipamentos::Item.new, indice: "NOVO" %></template>
        <button type="button" data-action="lista#adicionar" class="inline-flex h-10 cursor-pointer items-center gap-2 rounded-xl border border-[var(--border-subtle)] px-4 text-sm font-semibold text-[var(--text-primary)] hover:border-[var(--accent-strong)] hover:text-[var(--accent-strong)]"><%= icone(:plus) %> Adicionar peça</button>
      </fieldset>
    </div>

    <p class="text-xs text-[var(--text-muted)]">Os campos marcados com * são requeridos.</p>
  <% end %>
<% end %>
