<%# Equipamentos de um envio, com a situação de cada um. locals: envio %>
<ul class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-subtle)] divide-y divide-[var(--border-subtle)]">
  <% envio.itens.each do |linha| %>
    <li class="flex flex-wrap items-start justify-between gap-x-4 gap-y-1 px-4 py-2.5 text-sm">
      <div class="min-w-0">
        <p class="font-semibold text-[var(--text-primary)]"><%= linha.item.nome %></p>
        <p class="mt-0.5 text-xs text-[var(--text-muted)]"><%= linha.item.identificacao %><%= " · kit #{linha.item.identificacao_kit}" if linha.item.no_kit? %></p>
        <% if linha.recebido_em %><p class="mt-0.5 text-xs text-[var(--text-muted)]">Recebido em <%= l(linha.recebido_em, format: "%d/%m/%Y %H:%M") %></p><% end %>
        <% if linha.devolucao_pendente? %><p class="mt-0.5 text-xs text-[var(--text-muted)]">Devolução aguardando <%= linha.devolver_para_nome %> desde <%= l(linha.devolucao_pedida_em, format: "%d/%m/%Y %H:%M") %></p><% end %>
        <% if linha.devolvido? %><p class="mt-0.5 text-xs text-[var(--text-muted)]">Devolvido em <%= l(linha.devolvido_em, format: "%d/%m/%Y %H:%M") %>, recebido por <%= linha.devolucao_recebida_por&.nome %><%= ". Observação: #{linha.observacao_da_devolucao}" if linha.observacao_da_devolucao.present? %></p><% end %>
      </div>
      <%= selo_da_linha(linha) %>
    </li>
  <% end %>
</ul>
