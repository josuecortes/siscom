<% titulo = emprestimo? ? "Empréstimos e cautelas" : "Movimentações" %>
<% content_for :title, titulo %>
<% consulta = request.query_parameters.except("page", "painel") %>

<%= render layout: "compartilhado/cabecalho_pagina", locals: { titulo: titulo, icone: (emprestimo? ? :clock : :send), migalha: [ "Equipamentos", caminho_da_lista ] } do %>
  <%= render "compartilhado/acao_cabecalho", rotulo: (emprestimo? ? "Novo empréstimo ou cautela" : "Nova movimentação"), icone: :plus,
        caminho: (emprestimo? ? new_equipamentos_emprestimo_path : new_equipamentos_movimentacao_path), opcoes: { data: { turbo_frame: "painel" } } %>
<% end %>

<%= turbo_stream_from "equipamentos" %>
<% filtrando = @filtros[:filtrando] %>
<% campo = "h-11 w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] text-sm text-[var(--text-primary)] outline-none focus:border-[var(--accent-strong)]" %>
<% rotulo = "text-sm font-medium text-[var(--text-secondary)]" %>
<% data = { controller: "mascara", mascara_tipo_value: "data", action: "input->mascara#aplicar" } %>
<section class="mt-6 rounded-[var(--radius-panel)] border border-[var(--border-subtle)] bg-[var(--surface-card)] shadow-[var(--shadow-card)]">
  <%= form_with url: caminho_da_lista, method: :get, id: "filtros_de_envios", class: "border-b border-[var(--border-subtle)] px-6 py-5",
        data: { controller: "filtro", turbo_frame: "envios_lista", turbo_action: "advance" } do |f| %>
    <% extras = @filtros.slice(:unidade_id, :atrasados, :criado_de, :criado_ate).values.count(&:present?) %>
    <div class="space-y-4" data-controller="recolher">
      <div class="flex items-end gap-2">
        <div class="min-w-0 flex-1 space-y-1.5">
          <%= f.label :q, "Buscar por código, pessoa, unidade ou equipamento (marca, serial, patrimônio…)", class: "sr-only md:not-sr-only #{rotulo}" %>
          <div class="relative">
            <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-[var(--text-muted)]"><%= icone(:search) %></span>
            <%= f.text_field :q, value: @filtros[:q], placeholder: "Código, pessoa, unidade ou equipamento", autocomplete: "off", data: { action: "input->filtro#digitar" }, class: "#{campo} pl-11 pr-4" %>
          </div>
        </div>
        <button type="submit" title="Filtrar" aria-label="Filtrar"
                class="inline-flex h-11 w-11 shrink-0 cursor-pointer items-center justify-center rounded-xl bg-[var(--accent-strong)] text-white hover:bg-[var(--accent-stronger)]"><%= icone(:search) %></button>
        <%= link_to caminho_da_lista, title: "Limpar filtros", aria: { label: "Limpar filtros" },
              class: "inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] text-[var(--text-secondary)] hover:border-[var(--accent-strong)]" do %>
          <%= icone(:x) %>
        <% end %>
      </div>
      <button type="button" data-recolher-target="botao" data-action="recolher#alternar" aria-expanded="false" aria-controls="mais_filtros"
              class="group inline-flex h-10 w-full cursor-pointer items-center justify-between gap-2 rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] px-4 text-sm font-semibold text-[var(--text-primary)] md:hidden">
        <span class="inline-flex items-center gap-2">
          Mais filtros
          <% if extras.positive? %><span class="inline-flex min-w-[1.5rem] items-center justify-center rounded-full bg-[var(--accent-soft)] px-2 py-0.5 text-[11px] text-[var(--accent-strong)]"><%= extras %></span><% end %>
        </span>
        <span class="text-[var(--text-secondary)] transition-transform group-aria-expanded:rotate-180"><%= icone(:chevron_right, classe: "h-4 w-4 rotate-90") %></span>
      </button>
      <div id="mais_filtros" data-recolher-target="bloco" class="hidden gap-4 md:grid md:grid-cols-2 xl:grid-cols-4 xl:items-end">
        <div class="mb-4 md:mb-0">
          <%= render "compartilhado/campo_autocomplete", nome: "unidade_id", id: "filtro_unidade", rotulo: "Unidade (origem ou destino)", flutuante: true, url: equipamentos_opcoes_de_unidades_path,
                valor: @filtros[:unidade_id], texto: @unidade&.sigla_e_nome, acao: "change->filtro#aplicar", placeholder: "Digite para buscar a unidade", vazio: "Nenhuma unidade cadastrada." %>
        </div>
        <div class="mb-4 grid grid-cols-2 gap-4 md:mb-0 md:contents">
          <div class="space-y-1.5">
            <label for="criado_de" class="<%= rotulo %>">Enviado de</label>
            <%= text_field_tag :criado_de, DataBr.formatar(@filtros[:criado_de]), placeholder: "dd/mm/aaaa", inputmode: "numeric", maxlength: 10, autocomplete: "off", data: data, class: "#{campo} px-4" %>
          </div>
          <div class="space-y-1.5">
            <label for="criado_ate" class="<%= rotulo %>">Enviado até</label>
            <%= text_field_tag :criado_ate, DataBr.formatar(@filtros[:criado_ate]), placeholder: "dd/mm/aaaa", inputmode: "numeric", maxlength: 10, autocomplete: "off", data: data, class: "#{campo} px-4" %>
          </div>
        </div>
        <% if emprestimo? %>
          <label class="flex h-11 items-center gap-2 rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] px-3 text-sm text-[var(--text-secondary)]">
            <%= check_box_tag :atrasados, "1", @filtros[:atrasados], data: { action: "change->filtro#aplicar" }, class: "h-4 w-4" %> <span>Só com a devolução atrasada</span>
          </label>
        <% end %>
      </div>
    </div>
  <% end %>

  <%= turbo_frame_tag "envios_lista", data: { turbo_action: "advance" } do %>
    <% @filtros.slice(:status, :ordem, :direcao).each do |nome, valor| %><%= hidden_field_tag nome, valor, id: nil, form: "filtros_de_envios" %><% end %>
    <% aba = "group inline-flex min-w-fit items-center gap-2 border-b-2 border-transparent px-3 py-3 text-sm font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] aria-[current]:border-[var(--accent-strong)] aria-[current]:text-[var(--text-primary)]" %>
    <% contador = "inline-flex min-w-[1.75rem] items-center justify-center rounded-full bg-[var(--surface-panel)] px-2 py-0.5 text-[11px] font-semibold text-[var(--text-muted)] group-aria-[current]:bg-[var(--accent-soft)] group-aria-[current]:text-[var(--accent-strong)]" %>
    <nav class="border-b border-[var(--border-subtle)] px-4 sm:px-6" aria-label="Etapas dos envios">
      <div class="flex gap-1 overflow-x-auto [scrollbar-width:none]">
        <% if filtrando %>
          <span class="<%= aba %>" aria-current="page"><span>Resultado</span> <span class="<%= contador %>"><%= @pagy.count %></span></span>
        <% else %>
          <% Equipamentos::MovimentacoesController::ABAS.each do |chave, nome| %>
            <%= link_to caminho_da_lista(status: chave), aria: { current: (chave == @filtros[:status] ? "page" : nil) }, class: aba do %>
              <span><%= nome %></span> <span class="<%= contador %>"><%= @contagens.fetch(chave, 0) %></span>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </nav>
    <%= render "compartilhado/resumo_tabela", texto: (filtrando ? "#{@pagy.count} envio(s) encontrado(s), de todas as etapas" : "#{@pagy.count} envio(s): #{Equipamentos::MovimentacoesController::ABAS.fetch(@filtros[:status]).downcase}") %>
    <% ordenavel = ->(nome, chave) do %>
      <% ativa = @filtros[:ordem] == chave %>
      <% proxima = ativa && @filtros[:direcao] == "asc" ? "desc" : "asc" %>
      <th scope="col" aria-sort="<%= ativa ? (@filtros[:direcao] == "asc" ? "ascending" : "descending") : "none" %>">
        <%= link_to url_for(consulta.merge(ordem: chave, direcao: proxima)), title: "Ordenar por #{nome.downcase}", class: "inline-flex items-center gap-1.5 hover:text-[var(--accent-strong)] #{'text-[var(--accent-strong)]' if ativa}" do %>
          <span><%= nome %></span>
          <span class="text-xs leading-none <%= "opacity-40" unless ativa %>" aria-hidden="true"><%= ativa ? (@filtros[:direcao] == "asc" ? "▲" : "▼") : "▲▼" %></span>
        <% end %>
      </th>
    <% end %>

    <div class="overflow-x-auto">
      <table class="collection-table min-w-[1080px]">
        <thead>
          <tr>
            <th scope="col">Código</th>
            <th scope="col">De → para</th>
            <th scope="col">Quem recebe</th>
            <th scope="col">Equipamentos</th>
            <% ordenavel.call("Enviado em", "criado") %>
            <% if emprestimo? %><% ordenavel.call("Devolução prevista", "previsao") %><% end %>
            <% if filtrando %><th scope="col">Etapa</th><% end %>
            <th scope="col" class="!pl-2">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% @envios.each do |envio| %>
            <% linhas = envio.itens %>
            <tr id="<%= dom_id(envio) %>">
              <td class="whitespace-nowrap font-semibold text-[var(--text-primary)]">
                <%= link_to envio.codigo, (emprestimo? ? equipamentos_emprestimo_path(envio) : equipamentos_movimentacao_path(envio)), class: "hover:text-[var(--accent-strong)]", data: { turbo_frame: "painel" } %>
                <% if emprestimo? %><p class="mt-1.5"><%= render "compartilhado/selo", texto: envio.nome_do_tipo, tom: :neutro %></p><% end %>
              </td>
              <td class="!whitespace-normal">
                <p class="text-sm text-[var(--text-primary)]"><%= envio.origem_nome %></p>
                <p class="mt-1 text-sm text-[var(--text-secondary)]">→ <%= envio.destino_nome %></p>
              </td>
              <td class="!whitespace-normal">
                <p class="text-sm text-[var(--text-primary)]"><%= envio.responsavel_nome %></p>
                <p class="mt-1 text-xs text-[var(--text-muted)]">Enviado por <%= envio.criada_por_nome %></p>
              </td>
              <td class="!whitespace-normal">
                <p class="text-sm text-[var(--text-primary)]"><%= linhas.size %> equipamento(s)</p>
                <p class="mt-1 text-xs text-[var(--text-muted)]"><%= linhas.group_by(&:nome_do_status).map { |nome, grupo| "#{grupo.size} #{nome.downcase}" }.join(" · ") %></p>
              </td>
              <td class="whitespace-nowrap"><%= l(envio.created_at, format: "%d/%m/%Y %H:%M") %></td>
              <% if emprestimo? %>
                <td class="whitespace-nowrap">
                  <p><%= l(envio.previsao_devolucao) if envio.previsao_devolucao %></p>
                  <% if envio.em_andamento? && envio.aceita? %><p class="mt-1 text-xs text-[var(--text-muted)]"><%= envio.dias_emprestado %> dia(s) emprestado</p><% end %>
                  <% if envio.dias_de_atraso.positive? %><p class="mt-1"><%= selo_de_atraso(envio) %></p><% end %>
                </td>
              <% end %>
              <% if filtrando %><td><%= selo_do_envio(envio) %></td><% end %>
              <td class="!pl-2 !pr-4"><%= render "equipamentos/movimentacoes/acoes", envio: envio %></td>
            </tr>
          <% end %>
          <% if @envios.empty? %>
            <tr><td colspan="8" class="px-6 py-10 text-center text-sm text-[var(--text-secondary)]">Nenhum envio encontrado.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render "compartilhado/paginacao", pagy: @pagy, quadro: "envios_lista" %>
  <% end %>
</section>
