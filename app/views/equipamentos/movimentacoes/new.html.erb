<% nome = emprestimo? ? "Novo empréstimo ou cautela" : "Nova movimentação" %>
<% content_for :title, nome %>
<% rodape = capture { render "compartilhado/rodape_painel", formulario: "formulario_envio", rotulo: "Enviar" } %>
<% entrada = "h-11 w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] px-4 text-sm text-[var(--text-primary)] outline-none focus:border-[var(--accent-strong)]" %>
<% rotulo = "text-sm font-medium text-[var(--text-secondary)]" %>
<% envio = params.fetch(:envio, {}) %>
<% novo = emprestimo? ? new_equipamentos_emprestimo_path : new_equipamentos_movimentacao_path %>
<%# Trocar a unidade recarrega o painel (a lista de equipamentos é a da origem; a de pessoas, a do destino), levando o que já foi preenchido. %>
<% do_formulario = "#formulario_envio [name^='envio[']" %>

<%= render layout: "compartilhado/painel_formulario",
      locals: { sobretitulo: (emprestimo? ? "Empréstimos e cautelas" : "Movimentações"), titulo: nome, voltar: caminho_da_lista, largo: true, rodape: rodape,
                descricao: (emprestimo? ? "O equipamento continua sendo da unidade de origem e volta na data combinada. Quem recebe aceita um termo de responsabilidade." :
                                          "O equipamento passa a ser da unidade de destino quando a pessoa der o recebido. Até lá fica em movimentação e você pode cancelar o envio.") } do %>
  <%= form_with url: (emprestimo? ? equipamentos_emprestimos_path : equipamentos_movimentacoes_path), id: "formulario_envio", class: "space-y-5" do %>
    <% if @erro.present? %>
      <%= render "compartilhado/faixa_aviso", tom: :erro, embutida: true, mensagem: @erro %>
    <% end %>

    <% if emprestimo? %>
      <div class="grid gap-5 sm:grid-cols-2">
        <div class="space-y-1.5">
          <label for="envio_tipo" class="<%= rotulo %>">Tipo *</label>
          <%= select_tag "envio[tipo]", options_for_select(Equipamentos::Movimentacao::TIPOS.slice(*Equipamentos::Movimentacao::DE_EMPRESTIMO).invert.to_a, envio[:tipo]), id: "envio_tipo", class: entrada %>
        </div>
        <div class="space-y-1.5">
          <label for="envio_previsao_devolucao" class="<%= rotulo %>">Devolução prevista *</label>
          <%= text_field_tag "envio[previsao_devolucao]", envio[:previsao_devolucao], id: "envio_previsao_devolucao", required: true, placeholder: "dd/mm/aaaa", inputmode: "numeric", maxlength: 10, autocomplete: "off",
                data: { controller: "mascara", mascara_tipo_value: "data", action: "input->mascara#aplicar" }, class: entrada %>
        </div>
      </div>
    <% end %>

    <div data-controller="recarregar-quadro" data-recarregar-quadro-url-value="<%= novo %>" data-recarregar-quadro-parametro-value="envio[origem_id]"
         data-recarregar-quadro-incluir-value="<%= "#{do_formulario}:not([name='envio[item_ids][]'])" %>">
      <% if @todas %>
        <%= render "compartilhado/campo_autocomplete", nome: "envio[origem_id]", id: "envio_origem", rotulo: "Unidade de origem *", obrigatorio: true, url: equipamentos_opcoes_de_unidades_path,
              valor: @origem&.id, texto: @origem&.sigla_e_nome, acao: "change->recarregar-quadro#recarregar", placeholder: "Digite para buscar a unidade", vazio: "Nenhuma unidade cadastrada.",
              ajuda: "Como administrador, você envia em nome de qualquer unidade (fica registrado)." %>
      <% elsif @unidades.one? %>
        <div class="space-y-1.5">
          <label for="envio_origem" class="<%= rotulo %>">Unidade de origem</label>
          <%= hidden_field_tag "envio[origem_id]", @unidades.first.id, id: nil %>
          <input type="text" id="envio_origem" readonly value="<%= @unidades.first.sigla_e_nome %>" class="<%= entrada %> text-[var(--text-secondary)]">
        </div>
      <% else %>
        <div class="space-y-1.5">
          <label for="envio_origem" class="<%= rotulo %>">Unidade de origem *</label>
          <%= select_tag "envio[origem_id]", options_for_select([ [ "Selecione a unidade", "" ] ] + @unidades.map { |unidade| [ unidade.sigla_e_nome, unidade.id ] }, @origem&.id), id: "envio_origem", required: true,
                class: entrada, data: { action: "change->recarregar-quadro#recarregar" } %>
          <% if @unidades.empty? %><p class="text-sm text-[var(--danger-text)]">Você não está lotado em nenhuma unidade: procure o RH.</p><% end %>
        </div>
      <% end %>
    </div>

    <div data-controller="recarregar-quadro" data-recarregar-quadro-url-value="<%= novo %>" data-recarregar-quadro-parametro-value="envio[destino_id]"
         data-recarregar-quadro-incluir-value="<%= "#{do_formulario}:not([name='envio[responsavel_id]'])" %>">
      <%= render "compartilhado/campo_autocomplete", nome: "envio[destino_id]", id: "envio_destino", rotulo: "Unidade de destino *", obrigatorio: true, url: equipamentos_opcoes_de_unidades_path,
            valor: @destino&.id, texto: @destino&.sigla_e_nome, acao: "change->recarregar-quadro#recarregar", placeholder: "Digite para buscar a unidade", vazio: "Nenhuma unidade cadastrada." %>
    </div>

    <% if @destino %>
      <%= render "compartilhado/campo_autocomplete", nome: "envio[responsavel_id]", id: "envio_responsavel", rotulo: "Quem recebe *", obrigatorio: true,
            url: equipamentos_opcoes_de_pessoas_path(unidade_id: @destino.id), valor: @responsavel&.id, texto: @responsavel&.nome, placeholder: "Digite o nome da pessoa",
            vazio: "Ninguém lotado em #{@destino.sigla_e_nome}. Peça ao RH para lotar a pessoa.", ajuda: "Só aparecem as pessoas lotadas em #{@destino.sigla_e_nome}." %>
    <% else %>
      <div class="space-y-1.5">
        <label for="envio_responsavel" class="<%= rotulo %>">Quem recebe *</label>
        <input type="text" id="envio_responsavel" disabled placeholder="Escolha primeiro a unidade de destino" class="<%= entrada %> opacity-60">
      </div>
    <% end %>

    <fieldset class="space-y-3" data-controller="selecao" id="equipamentos_do_envio">
      <div class="flex flex-wrap items-end justify-between gap-2">
        <legend class="text-sm font-semibold text-[var(--text-primary)]">Equipamentos *</legend>
        <span class="text-xs font-semibold text-[var(--accent-strong)]" data-selecao-target="contagem" aria-live="polite"></span>
      </div>
      <% if @origem.nil? %>
        <p class="rounded-xl border border-dashed border-[var(--border-subtle)] px-4 py-6 text-center text-sm text-[var(--text-secondary)]">Escolha a unidade de origem para ver os equipamentos.</p>
      <% elsif @itens.empty? %>
        <p class="rounded-xl border border-dashed border-[var(--border-subtle)] px-4 py-6 text-center text-sm text-[var(--text-secondary)]">Não há equipamento ativo em <%= @origem.sigla_e_nome %>.</p>
      <% else %>
        <div class="relative">
          <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-[var(--text-muted)]"><%= icone(:search) %></span>
          <input type="search" aria-label="Filtrar os equipamentos da lista" placeholder="Filtrar por tipo, marca, modelo, serial, patrimônio ou kit" autocomplete="off"
                 data-selecao-target="busca" data-action="input->selecao#filtrar" class="<%= entrada %> pl-11">
        </div>
        <div class="max-h-[22rem] overflow-y-auto rounded-xl border border-[var(--border-subtle)]">
          <% kit_anterior = nil %>
          <% textos_dos_kits = @itens.select(&:no_kit?).group_by(&:codigo_kit).transform_values { |pecas| pecas.map { |peca| "#{peca.nome_completo} #{peca.identificacao_kit} #{peca.codigo_kit}" }.join(" ").downcase } %>
          <% @itens.each do |item| %>
            <% preso = @presos[item.id] %>
            <% if item.no_kit? && item.codigo_kit != kit_anterior %>
              <div class="flex items-center justify-between gap-3 border-b border-[var(--border-subtle)] bg-[var(--surface-subtle)] px-4 py-2" data-selecao-target="linha" data-grupo-titulo="<%= item.codigo_kit %>"
                   data-texto="<%= textos_dos_kits[item.codigo_kit] %>">
                <p class="min-w-0 truncate text-xs font-semibold uppercase tracking-[0.08em] text-[var(--text-muted)]">Kit <%= item.identificacao_kit.presence || item.codigo_kit %> · <%= item.codigo_kit %></p>
                <button type="button" data-action="selecao#marcarGrupo" data-selecao-grupo-param="<%= item.codigo_kit %>"
                        class="shrink-0 cursor-pointer rounded-md border border-[var(--border-subtle)] px-2.5 py-1 text-xs font-semibold text-[var(--text-primary)] hover:border-[var(--accent-strong)] hover:text-[var(--accent-strong)]">Kit inteiro</button>
              </div>
            <% end %>
            <% kit_anterior = item.codigo_kit %>
            <label class="flex items-start gap-3 border-b border-[var(--border-subtle)] px-4 py-2.5 text-sm last:border-b-0 <%= preso ? "opacity-60" : "cursor-pointer hover:bg-[var(--surface-subtle)]" %>"
                   data-selecao-target="linha" data-grupo="<%= item.codigo_kit %>" data-texto="<%= "#{item.nome_completo} #{item.numero_serial} #{item.numero_patrimonio} #{item.identificacao_kit} #{item.codigo_kit}".downcase %>">
              <%= check_box_tag "envio[item_ids][]", item.id, (!preso && @marcados.include?(item.id)), id: "envio_item_#{item.id}", disabled: preso.present?, data: { action: "change->selecao#contar" }, class: "mt-0.5 h-4 w-4 shrink-0" %>
              <span class="min-w-0">
                <span class="block font-semibold text-[var(--text-primary)]"><%= item.nome %></span>
                <span class="mt-0.5 block text-xs text-[var(--text-muted)]"><%= item.identificacao %><%= " · #{item.localizacao_fisica}" if item.localizacao_fisica.present? %></span>
                <% if preso %><span class="mt-0.5 block text-xs text-[var(--warning-text)]"><%= item.nome_da_situacao %>: <%= preso.movimentacao.codigo %>, com <%= preso.movimentacao.responsavel_nome %></span><% end %>
              </span>
            </label>
          <% end %>
          <p hidden data-selecao-target="vazio" class="px-4 py-6 text-center text-sm text-[var(--text-secondary)]">Nenhum equipamento combina com o filtro.</p>
        </div>
        <p class="text-xs text-[var(--text-muted)]">Só os equipamentos ativos de <%= @origem.sigla_e_nome %>. Os que já estão em outro envio aparecem apagados.</p>
      <% end %>
    </fieldset>

    <div class="space-y-1.5">
      <label for="envio_descricao" class="<%= rotulo %>">Observação</label>
      <%= text_area_tag "envio[descricao]", envio[:descricao], id: "envio_descricao", rows: 3, maxlength: 1000,
            class: "min-h-24 w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] px-4 py-3 text-sm text-[var(--text-primary)] outline-none focus:border-[var(--accent-strong)]" %>
    </div>
    <p class="text-xs text-[var(--text-muted)]">Os campos marcados com * são requeridos.</p>
  <% end %>
<% end %>
