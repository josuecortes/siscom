<% content_for :title, "Gerenciar permissões" %>
<% rodape = capture { render "compartilhado/rodape_painel", formulario: "formulario_permissao", rotulo: "Salvar permissões" } %>
<% descricoes = { "admin" => "Vê e age sobre os equipamentos de todas as unidades, concede permissões e pode dar o recebido em nome de outra pessoa (fica registrado).",
                  "gestor" => "Vê, cadastra, edita, movimenta e empresta ou cautela os equipamentos das unidades em que está lotado." } %>

<%= render layout: "compartilhado/painel_formulario",
      locals: { sobretitulo: "Permissões", titulo: "Gerenciar permissões de #{@usuario.nome}", voltar: equipamentos_permissoes_path, rodape: rodape,
                descricao: @usuario.email } do %>
  <%= form_with url: equipamentos_permissao_path(@usuario), method: :patch, id: "formulario_permissao", class: "space-y-5" do |f| %>
    <% if @erro.present? %>
      <%= render "compartilhado/faixa_aviso", tom: :erro, embutida: true, mensagem: @erro %>
    <% end %>

    <fieldset class="space-y-2">
      <legend class="mb-2 text-sm font-medium text-[var(--text-secondary)]">Permissões em Equipamentos</legend>
      <%= hidden_field_tag "papeis[]", "", id: nil %>
      <% @papeis.each do |papel| %>
        <% marcado = @papeis_atuais.include?(papel.chave) %>
        <% pode = marcado || Core::Api.pode_conceder?(current_user, modulo: :equipamentos, papel: papel.chave) %>
        <label class="flex items-start gap-3 rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] px-4 py-3 text-sm <%= "opacity-60" unless pode %>">
          <%= check_box_tag "papeis[]", papel.chave, marcado, id: "papel_#{papel.chave}", disabled: !pode, class: "mt-0.5 h-4 w-4" %>
          <span>
            <span class="block font-semibold text-[var(--text-primary)]"><%= papel.nome %></span>
            <span class="block text-[var(--text-secondary)]"><%= descricoes[papel.chave] %></span>
          </span>
        </label>
      <% end %>
      <p class="text-xs text-[var(--text-muted)]">Sem nenhuma marcada, o usuário só recebe equipamentos e recebe ou devolve empréstimos (isso é de todos).</p>
    </fieldset>
  <% end %>
<% end %>
