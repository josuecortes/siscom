<!DOCTYPE html>
<html lang="pt-BR" class="h-full antialiased">
  <head>
    <%= render "layouts/compartilhado/head" %>
  </head>

  <%# Shell administrativo (porta de seed/web/components/layout/admin-shell.tsx). %>
  <body class="min-h-full" data-controller="menu-lateral lancador" data-lancador-lista-value="<%= lancador_conversas_path %>">
    <div class="min-h-screen w-full max-w-full overflow-x-hidden bg-[var(--surface-page)] text-[var(--text-primary)]">
      <div class="flex min-h-screen w-full min-w-0 max-w-full overflow-x-hidden">
        <aside id="menu-lateral"
               class="hidden w-[252px] shrink-0 border-r border-[var(--shell-border)] bg-[var(--shell-sidebar)] text-[var(--shell-sidebar-text)] lg:fixed lg:inset-y-0 lg:left-0 lg:z-40 lg:flex lg:h-screen lg:flex-col menu-recolhido:w-[72px]">
          <%= render "layouts/compartilhado/menu_lateral" %>
        </aside>

        <div class="flex min-h-screen w-full min-w-0 max-w-full flex-1 flex-col overflow-x-hidden lg:ml-[252px] menu-recolhido:lg:ml-[72px]">
          <%= render "layouts/compartilhado/topo" %>

          <main class="w-full min-w-0 max-w-full flex-1 overflow-x-hidden px-4 pb-24 pt-16 sm:px-6 lg:px-8"><%# pb-24 (no seed é pb-6): dá para rolar o fim da página para cima do ícone das conversas %>
            <div class="min-w-0 max-w-full">
              <%= yield %>
            </div>
          </main>
        </div>
      </div>

      <%= turbo_stream_from current_user, :notificacoes %>
      <%= render "core/conversas/lancador" %>
      <%= render "compartilhado/flash" %>
      <%= render "compartilhado/confirmacao" %>
      <%# Painel de formulário: as views new/edit entregam o próprio quadro. %>
      <%# Com ?painel=/caminho (link de notificação para uma tela de "ver"), o painel abre sozinho por cima da lista. %>
      <%= turbo_frame_tag "painel", src: painel_inicial unless content_for?(:tem_painel) %>

      <%# Menu no celular (gaveta). %>
      <div data-menu-lateral-target="gaveta" class="fixed inset-0 z-50 hidden bg-[#08111fcc] lg:hidden">
        <button type="button" class="absolute inset-0 cursor-pointer" data-action="menu-lateral#fecharGaveta" aria-label="Fechar menu"></button>
        <div class="relative flex h-full w-[min(86vw,20rem)] flex-col border-r border-[var(--shell-sidebar-divider)] bg-[var(--shell-sidebar)] text-[var(--shell-sidebar-text)]">
          <%= render "layouts/compartilhado/menu_lateral", gaveta: true %>
        </div>
      </div>
    </div>
  </body>
</html>
