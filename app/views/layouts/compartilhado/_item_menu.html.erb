<%# Um item do menu lateral: link simples ou grupo (módulo) com filhos. %>
<% ativo = item_menu_ativo?(item) %>
<% esconder_no_recolhido = gaveta ? "" : "menu-recolhido:lg:hidden" %>

<% if item[:filhos] %>
  <details class="group/grupo space-y-1.5" <%= "open" if ativo %>>
    <summary title="<%= item[:rotulo] %>"
             class="group flex w-full cursor-pointer list-none items-center gap-3 rounded-md border px-3 py-2.5 transition [&::-webkit-details-marker]:hidden <%= "menu-recolhido:lg:justify-center" unless gaveta %> <%= ativo ? "border-white/10 bg-white/4 text-white" : "border-transparent text-[var(--shell-sidebar-text)] hover:bg-white/4 hover:text-white" %>">
      <span class="flex h-5 w-5 shrink-0 items-center justify-center group-hover:text-white <%= ativo ? "text-white" : "text-[var(--shell-sidebar-muted)]" %>">
        <%= icone(item[:icone], classe: "h-full w-full") %>
      </span>
      <span class="min-w-0 flex-1 text-left text-sm font-semibold <%= esconder_no_recolhido %>"><%= item[:rotulo] %></span>
      <span class="flex h-4 w-4 items-center justify-center transition-transform group-open/grupo:rotate-90 <%= esconder_no_recolhido %>">
        <%= icone(:chevron_right, classe: "h-3.5 w-3.5") %>
      </span>
    </summary>

    <div class="ml-3 space-y-1.5 border-l border-white/8 pl-3 <%= "menu-recolhido:lg:ml-0 menu-recolhido:lg:border-l-0 menu-recolhido:lg:pl-0" unless gaveta %>">
      <%= render partial: "layouts/compartilhado/item_menu", collection: item[:filhos], as: :item, locals: { gaveta: gaveta, nivel: nivel + 1 } %>
    </div>
  </details>
<% else %>
  <%= link_to item[:caminho],
        title: item[:rotulo],
        aria: { current: (ativo ? "page" : nil) },
        data: { action: (gaveta ? "menu-lateral#fecharGaveta" : nil) },
        class: [
          "group flex items-center gap-3 rounded-md border px-3 transition",
          (nivel.zero? ? "py-2.5" : (nivel == 1 ? "py-2" : "py-1.5")),
          ("menu-recolhido:lg:justify-center" unless gaveta),
          (ativo ? "border-[var(--shell-sidebar-active-border)] bg-[var(--shell-sidebar-active)] text-white shadow-[inset_3px_0_0_var(--system-accent-strong)]"
                 : "border-transparent text-[var(--shell-sidebar-text)] hover:bg-white/4 hover:text-white")
        ] do %>
    <span class="flex h-5 w-5 shrink-0 items-center justify-center group-hover:text-white <%= ativo ? "text-white" : "text-[var(--shell-sidebar-muted)]" %>">
      <%= icone(item[:icone], classe: "h-full w-full") %>
    </span>
    <span class="text-sm <%= "font-semibold" if nivel.zero? %> <%= esconder_no_recolhido %>"><%= item[:rotulo] %></span>
  <% end %>
<% end %>
