<% content_for :title, "Gerenciar permissões" %>
<% rodape = capture { render "compartilhado/rodape_painel", formulario: "formulario_acesso", rotulo: "Salvar permissão" } %>

<%= render layout: "compartilhado/painel_formulario",
      locals: { sobretitulo: "Acessos", titulo: @usuario.nome, voltar: rh_acessos_path, rodape: rodape,
                descricao: "Cada usuário tem no máximo uma permissão no RH. Escolher outra substitui a atual; \"Sem permissão\" deixa só a própria ficha." } do %>
  <%= form_with url: rh_acesso_path(@usuario), method: :patch, id: "formulario_acesso", class: "space-y-5" do |f| %>
    <% if @erro.present? %>
      <%= render "compartilhado/faixa_aviso", tom: :erro, embutida: true, mensagem: @erro %>
    <% end %>

    <fieldset class="space-y-2">
      <legend class="text-sm font-medium text-[var(--text-secondary)]">Permissão no RH</legend>
      <% ([ [ "", "Sem permissão", "Vê só a própria ficha." ] ] + @papeis.map { |papel| [ papel.chave, papel.nome, "#{papel.permissoes.size} ação(ões) do RH." ] }).each do |chave, nome, detalhe| %>
        <% pode = chave.blank? || Core::Api.pode_conceder?(current_user, modulo: :rh, papel: chave) %>
        <label class="flex items-start gap-3 rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] px-3 py-3 text-sm <%= "opacity-60" unless pode %>">
          <%= radio_button_tag :papel, chave, @papel_atual.to_s == chave, id: "papel_#{chave.presence || 'nenhum'}", disabled: !pode, class: "mt-0.5 h-4 w-4" %>
          <span>
            <span class="block font-semibold text-[var(--text-primary)]"><%= nome %></span>
            <span class="block text-[var(--text-secondary)]"><%= detalhe %></span>
          </span>
        </label>
      <% end %>
    </fieldset>
  <% end %>
<% end %>
