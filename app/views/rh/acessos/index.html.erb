<% content_for :title, "Acessos" %>
<% nomes = @papeis.to_h { |papel| [ papel.chave, papel.nome ] } %>
<% campo = "h-11 w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] text-sm outline-none focus:border-[var(--accent-strong)]" %>

<%= render layout: "compartilhado/cabecalho_pagina", locals: { titulo: "Acessos", icone: :shield_alt, migalha: [ "RH", rh_acessos_path ] } do %>
<% end %>

<section class="mt-6 rounded-[var(--radius-panel)] border border-[var(--border-subtle)] bg-[var(--surface-card)] shadow-[var(--shadow-card)]">
  <%= form_with url: rh_acessos_path, method: :get, class: "border-b border-[var(--border-subtle)] px-6 py-5",
        data: { controller: "filtro", turbo_frame: "acessos_lista", turbo_action: "advance" } do |f| %>
    <div class="grid gap-4 lg:grid-cols-[1.2fr_0.6fr_auto] lg:items-end">
      <div class="space-y-1.5">
        <%= f.label :q, "Buscar por nome ou e-mail", class: "text-sm font-medium text-[var(--text-secondary)]" %>
        <div class="relative">
          <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-[var(--text-muted)]"><%= icone(:search) %></span>
          <%= f.text_field :q, value: @filtros[:q], placeholder: "Ex.: Maria Oliveira", autocomplete: "off", data: { action: "input->filtro#digitar" }, class: "#{campo} pl-11 pr-4" %>
        </div>
      </div>
      <div class="space-y-1.5">
        <%= f.label :situacao, "Permissão no RH", class: "text-sm font-medium text-[var(--text-secondary)]" %>
        <%= f.select :situacao, [ [ "Todos os usuários", "todos" ], [ "Com permissão", "com" ], [ "Sem permissão", "sem" ] ],
              { selected: @filtros[:situacao] }, data: { action: "change->filtro#aplicar" }, class: "#{campo} px-4" %>
      </div>
      <div class="flex flex-row gap-2">
        <button type="submit" title="Filtrar usuários" aria-label="Filtrar usuários"
                class="inline-flex h-11 w-11 cursor-pointer items-center justify-center rounded-xl bg-[var(--accent-strong)] text-white hover:bg-[var(--accent-stronger)]"><%= icone(:search) %></button>
        <%= link_to rh_acessos_path, title: "Limpar filtros", aria: { label: "Limpar filtros" },
              class: "inline-flex h-11 w-11 items-center justify-center rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] text-[var(--text-secondary)] hover:border-[var(--accent-strong)]" do %>
          <%= icone(:x) %>
        <% end %>
      </div>
    </div>
  <% end %>

  <%= turbo_frame_tag "acessos_lista", data: { turbo_action: "advance" } do %>
    <%= render "compartilhado/resumo_tabela", texto: "#{@pagy.count} usuário(s) listado(s)" %>

    <div class="overflow-x-auto">
      <table class="collection-table min-w-[820px]">
        <thead>
          <tr>
            <th scope="col">Usuário</th>
            <th scope="col">E-mail</th>
            <th scope="col">Permissões</th>
            <th scope="col">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% @usuarios.each do |usuario| %>
            <% papeis = @concedidos.fetch(usuario.id, []) %>
            <tr id="<%= dom_id(usuario, :acesso) %>">
              <td><p class="text-sm font-semibold text-[var(--text-primary)]"><%= usuario.nome %></p></td>
              <td><%= usuario.email %></td>
              <td>
                <div class="flex flex-nowrap gap-2">
                  <% papeis.each do |papel| %><%= render "compartilhado/selo", texto: nomes[papel] || papel %><% end %>
                  <% if papeis.empty? %><span class="text-sm text-[var(--text-muted)]">Sem permissão (só a própria ficha)</span><% end %>
                </div>
              </td>
              <td><%= render "compartilhado/botao_acao", titulo: "Gerenciar permissões", icone: :shield_alt, caminho: edit_rh_acesso_path(usuario), quadro: "painel" %></td>
            </tr>
          <% end %>
          <% if @usuarios.empty? %>
            <tr><td colspan="4" class="px-6 py-10 text-center text-sm text-[var(--text-secondary)]">Nenhum usuário encontrado para os filtros informados.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render "compartilhado/paginacao", pagy: @pagy, quadro: "acessos_lista" %>
  <% end %>
</section>
