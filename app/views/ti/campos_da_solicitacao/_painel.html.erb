<% novo = @campo.new_record? %>
<% rodape = capture { render "compartilhado/rodape_painel", formulario: "formulario_campo", rotulo: (novo ? "Salvar campo" : "Salvar alterações") } %>
<% entrada = "w-full rounded-xl border bg-[var(--filter-field-bg)] px-4 text-sm text-[var(--text-primary)] outline-none" %>
<% borda = ->(campo) { @campo.errors[campo].any? ? "border-[var(--danger-border-strong)] focus:border-[var(--danger-border-strong)]" : "border-[var(--border-subtle)] focus:border-[var(--accent-strong)]" } %>

<%= render layout: "compartilhado/painel_formulario",
      locals: { sobretitulo: "Campos da solicitação", titulo: (novo ? "Novo campo" : "Editar campo"), voltar: ti_solicitacao_campos_path(@solicitacao), rodape: rodape,
                descricao: @solicitacao.nome } do %>
  <%= form_with model: @campo, scope: :campo, url: (novo ? ti_solicitacao_campos_path(@solicitacao) : ti_solicitacao_campo_path(@solicitacao, @campo)),
        id: "formulario_campo", class: "space-y-5", data: { controller: "mostrar-por-valor" } do |f| %>
    <% if @campo.errors.any? %>
      <%= render "compartilhado/faixa_aviso", tom: :erro, embutida: true, mensagem: "Revise os campos destacados e tente novamente." %>
    <% end %>

    <%= render "compartilhado/campo", f: f, campo: :rotulo, rotulo: "Nome *", html: { required: true, maxlength: 120 } %>
    <%= render "compartilhado/campo", f: f, campo: :tipo, rotulo: "Tipo *", tipo: :select, opcoes: Ti::CampoProblema::TIPOS.invert.to_a,
          html: { data: { mostrar_por_valor_target: "campo", action: "change->mostrar-por-valor#atualizar" } } %>

    <div class="space-y-1.5" data-mostrar-por-valor-target="bloco" data-valores="<%= Ti::CampoProblema::COM_OPCOES.join(" ") %>">
      <%= f.label :opcoes, "Opções * (uma por linha)", class: "text-sm font-medium text-[var(--text-secondary)]" %>
      <%= f.text_area :opcoes, value: @campo.opcoes.join("\n"), rows: 5, placeholder: "Uma opção por linha", class: "#{entrada} min-h-28 py-3 #{borda.call(:opcoes)}" %>
      <% @campo.errors[:opcoes].each do |mensagem| %><p class="text-sm text-[var(--danger-text)]">Opções <%= mensagem %></p><% end %>
    </div>

    <div class="space-y-1.5" data-mostrar-por-valor-target="bloco" data-valores="<%= Ti::CampoProblema::COM_FONTE.join(" ") %>">
      <%= f.label :fonte, "Fonte de dados *", class: "text-sm font-medium text-[var(--text-secondary)]" %>
      <%= f.select :fonte, @fontes, { include_blank: "Selecione uma fonte publicada", selected: @campo.fonte }, class: "#{entrada} h-11 #{borda.call(:fonte)}" %>
      <p class="text-xs text-[var(--text-muted)]">O usuário procura digitando (ex.: uma pessoa, uma unidade). As fontes ficam em Administração → Fontes de referência.</p>
      <% @campo.errors[:fonte].each do |mensagem| %><p class="text-sm text-[var(--danger-text)]">Fonte de dados <%= mensagem %></p><% end %>
    </div>

    <div data-mostrar-por-valor-target="bloco" data-valores="<%= Ti::CampoProblema::COM_MASCARA.join(" ") %>">
      <%= render "compartilhado/campo", f: f, campo: :mascara, rotulo: "Máscara", tipo: :select, opcoes: [ [ "Sem máscara", "" ] ] + Ti::CampoProblema::MASCARAS.invert.to_a %>
    </div>

    <label class="flex items-center gap-3 rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] px-4 py-3 text-sm text-[var(--text-primary)]">
      <%= f.check_box :obrigatorio %> <span>Campo obrigatório</span>
    </label>
    <%= render "compartilhado/campo", f: f, campo: :exemplo, rotulo: "Texto de exemplo (dentro do campo)", html: { maxlength: 120 } %>
    <%= render "compartilhado/campo", f: f, campo: :ajuda, rotulo: "Texto de ajuda (embaixo do campo)", tipo: :textarea, curto: true, html: { maxlength: 300 } %>
    <% unless novo %>
      <%= render "compartilhado/campo", f: f, campo: :posicao, rotulo: "Ordem", tipo: :number, html: { min: 1 } %>
    <% end %>

    <p class="text-sm text-[var(--text-muted)]">Os campos marcados com * são requeridos.</p>
  <% end %>
<% end %>
