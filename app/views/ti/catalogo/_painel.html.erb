<% novo = @registro.new_record? %>
<%# Sobretítulo, título e botão do seed: categorias usam "CATEGORIAS DE SOLICITAÇÃO" + "Nova/Editar categoria";
    perfis e grupos usam "Novo perfil" + "Cadastrar perfil de abertura" (helpdesk-*-module.tsx). %>
<% curto = { "categorias" => "categoria", "perfis_abertura" => "perfil", "grupos_tecnicos" => "grupo" }.fetch(@tabela.chave) %>
<% if @tabela.chave == "categorias" %>
  <% sobretitulo = @tabela.titulo %>
  <% titulo = novo ? "Nova categoria" : "Editar categoria" %>
<% else %>
  <% sobretitulo = novo ? "Novo #{curto}" : "Editar #{curto}" %>
  <% titulo = novo ? "Cadastrar #{@tabela.singular}" : "Atualizar #{@tabela.singular}" %>
<% end %>
<% rodape = capture { render "compartilhado/rodape_painel", formulario: "formulario_catalogo", rotulo: (novo ? "Salvar #{curto}" : "Salvar alterações") } %>

<%= render layout: "compartilhado/painel_formulario",
      locals: { sobretitulo: sobretitulo, titulo: titulo, descricao: @tabela.ajuda, voltar: caminho_da_lista, rodape: rodape } do %>
  <%= form_with model: @registro, scope: :registro, url: (novo ? caminho_da_lista : caminho_do_registro(@registro)), id: "formulario_catalogo", class: "space-y-5" do |f| %>
    <% if @registro.errors.any? %>
      <%= render "compartilhado/faixa_aviso", tom: :erro, embutida: true, mensagem: (@registro.errors[:base].first || "Revise os campos destacados e tente novamente.") %>
    <% end %>

    <%= render "compartilhado/campo", f: f, campo: :nome, rotulo: "Nome *", html: { required: true, maxlength: 120, autofocus: true } %>
    <%= render "compartilhado/campo", f: f, campo: :descricao, rotulo: "Descrição", tipo: :textarea, html: { maxlength: 300 } %>
    <% if @tabela.grupo? %>
      <%# Chave liga/desliga do seed ("Permitir autoatribuição"), feita só com CSS sobre a caixa de marcação. %>
      <div class="space-y-2">
        <span class="block text-sm font-medium text-[var(--text-secondary)]">Permitir autoatribuição</span>
        <label class="flex h-11 w-full cursor-pointer items-center justify-between rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] px-4 text-sm text-[var(--text-secondary)] has-checked:border-[var(--accent-strong)] has-checked:bg-[#edf2ff] dark:has-checked:bg-[var(--accent-soft)] has-checked:text-[var(--accent-strong)] has-focus-visible:outline-2 has-focus-visible:outline-[var(--accent-strong)]">
          <%= f.check_box :permite_autoatribuicao, class: "peer sr-only" %>
          <span class="peer-checked:hidden">Autoatribuição desligada</span>
          <span class="hidden peer-checked:inline">Autoatribuição ligada</span>
          <span class="inline-flex h-5 w-9 items-center rounded-full bg-[var(--border-subtle)] p-0.5 transition peer-checked:bg-[var(--accent-strong)] peer-checked:*:translate-x-4" aria-hidden="true">
            <span class="block h-4 w-4 rounded-full bg-white transition"></span>
          </span>
        </label>
        <p class="text-xs text-[var(--text-muted)]">Ligada, os membros do grupo podem assumir os chamados. Desligada, só a supervisão atribui os chamados deste grupo.</p>
      </div>
    <% end %>

    <% if @tabela.perfil? %>
      <label class="flex items-start gap-3 rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] px-4 py-3 text-sm text-[var(--text-secondary)]">
        <%= f.check_box :padrao, class: "mt-0.5 h-4 w-4" %>
        <span>
          <span class="block font-semibold text-[var(--text-primary)]">Perfil padrão</span>
          <span class="block">Vale para todos os usuários, sem precisar incluir um por um.</span>
        </span>
      </label>
    <% end %>

    <p class="<%= @tabela.perfil? ? "text-xs" : "text-sm" %> text-[var(--text-muted)]">Os campos marcados com * são requeridos.</p>
  <% end %>
<% end %>
