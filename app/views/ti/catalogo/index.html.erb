<% content_for :title, @tabela.titulo %>
<% singular = @tabela.singular %>
<% categorias = @tabela.chave == "categorias" %>
<%# Textos do seed (helpdesk-request-categories, -opening-profiles e -technical-groups-module.tsx). %>
<% textos = { "categorias" => { curto: "categoria", resumo: "categoria(s) registrada(s)", vazio: "Nenhuma categoria encontrada", exemplo: "Ex.: rede" },
              "perfis_abertura" => { curto: "perfil", resumo: "perfil(is) de abertura registrado(s)", vazio: "Nenhum perfil encontrado", exemplo: "Ex.: solicitante escolar" },
              "grupos_tecnicos" => { curto: "grupo", resumo: "grupo(s) técnico(s) registrado(s)", vazio: "Nenhum grupo técnico encontrado", exemplo: "Ex.: infraestrutura" } }.fetch(@tabela.chave) %>
<% item = @tabela.perfil? ? "perfil" : singular %>
<% solicitacoes = categorias ? {} : @tabela.modelo.where(id: @registros.map(&:id)).joins(:vinculos_de_problema).group(:id).count %>

<%= render layout: "compartilhado/cabecalho_pagina", locals: { titulo: @tabela.titulo, icone: @tabela.icone, migalha: [ "TI", caminho_da_lista ] } do %>
  <%= render "compartilhado/acao_cabecalho", rotulo: "#{@tabela.novo} #{textos[:curto]}", icone: :plus, caminho: caminho_novo, opcoes: { data: { turbo_frame: "painel" } } %>
<% end %>

<section class="mt-6 rounded-[var(--radius-panel)] border border-[var(--border-subtle)] bg-[var(--surface-card)] shadow-[var(--shadow-card)]">
  <%= render "compartilhado/filtro_busca_status", url: caminho_da_lista, quadro: "catalogo_lista", rotulo_busca: "Buscar por nome",
        exemplo: textos[:exemplo], busca: @filtros[:q], status: @filtros[:status],
        opcoes_status: [ [ "Todos", "todos" ], [ "Ativos", "ativo" ], [ "Inativos", "inativo" ] ], titulo_filtrar: "Filtrar #{@tabela.titulo.split.first.downcase}" %>

  <%= turbo_frame_tag "catalogo_lista", data: { turbo_action: "advance" } do %>
    <%= render "compartilhado/resumo_tabela", texto: "#{@pagy.count} #{textos[:resumo]}" %>

    <div class="overflow-x-auto">
      <table class="collection-table min-w-[980px]">
        <thead>
          <tr>
            <% if categorias %>
              <th scope="col">Categoria</th>
            <% else %>
              <th scope="col">Nome</th>
              <th scope="col">Descrição</th>
              <% if @tabela.grupo? %><th scope="col">Autoatribuição</th><% end %>
              <th scope="col"><%= @tabela.grupo? ? "Membros" : "Usuários" %></th>
              <th scope="col">Solicitações</th>
            <% end %>
            <th scope="col">Status</th>
            <th scope="col">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% @registros.each do |registro| %>
            <tr id="<%= dom_id(registro) %>">
              <% if categorias %>
                <td>
                  <div class="space-y-1">
                    <p class="font-semibold text-[var(--text-primary)]"><%= registro.nome %></p>
                    <p class="text-sm text-[var(--text-secondary)]"><%= registro.descricao.presence || "Sem descrição cadastrada." %></p>
                  </div>
                </td>
              <% else %>
                <td class="font-semibold text-[var(--text-primary)]"><%= registro.nome %></td>
                <td><%= registro.descricao.presence || "Sem descrição cadastrada." %></td>
                <% if @tabela.grupo? %>
                  <td><%= render "compartilhado/selo", texto: (registro.permite_autoatribuicao? ? "Permitida" : "Desligada"), tom: (registro.permite_autoatribuicao? ? :info : :neutro) %></td>
                <% end %>
                <td><%= @contagens.fetch(registro.id, 0) %></td>
                <td><%= solicitacoes.fetch(registro.id, 0) %></td>
              <% end %>
              <td><%= render "compartilhado/selo", texto: (registro.ativo? ? "Ativ#{@tabela.artigo}" : "Inativ#{@tabela.artigo}"), tom: (registro.ativo? ? :sucesso : :atencao) %></td>
              <td>
                <div class="flex flex-nowrap items-center gap-2">
                  <% if @tabela.grupo? %>
                    <%= render "compartilhado/botao_acao", titulo: "Gerenciar membros", icone: :people, caminho: edit_ti_grupo_tecnico_membros_path(registro), quadro: "painel" %>
                  <% end %>
                  <% if @tabela.grupo? || @tabela.perfil? %>
                    <%= render "compartilhado/botao_acao", titulo: "Gerenciar solicitações", icone: :list_rich, quadro: "painel",
                          caminho: (@tabela.grupo? ? edit_ti_grupo_tecnico_solicitacoes_path(registro) : edit_ti_perfil_abertura_solicitacoes_path(registro)) %>
                  <% end %>
                  <%= render "compartilhado/botao_acao", titulo: "Editar #{item}", icone: :pencil, caminho: caminho_editar(registro), quadro: "painel" %>
                  <% if registro.ativo? %>
                    <%= render "compartilhado/botao_acao", titulo: "Desativar #{item}", icone: :ban, caminho: caminho_de_status(registro, :desativar), metodo: :patch,
                          confirmar: { mensagem: "Confirme a desativação de #{registro.nome}. O item deixa de aparecer nas opções.", rotulo: "Desativar" } %>
                  <% else %>
                    <%= render "compartilhado/botao_acao", titulo: "Ativar #{item}", icone: :check_circle, caminho: caminho_de_status(registro, :ativar), metodo: :patch,
                          confirmar: { mensagem: "Confirme a ativação de #{registro.nome}.", rotulo: "Ativar", tom: "primario" } %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
          <% if @registros.empty? %>
            <tr><td colspan="7" class="px-6 py-10 text-center text-sm text-[var(--text-secondary)]"><%= textos[:vazio] %> para os filtros informados.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render "compartilhado/paginacao", pagy: @pagy, quadro: "catalogo_lista" %>
  <% end %>
</section>
