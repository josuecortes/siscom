<%# Um campo do formulário da solicitação, conforme o tipo. locals: campo (Ti::CampoProblema), valor (o que foi digitado), erro (mensagem ou nil),
    solicitante_id (quando a TI abre em nome de outra pessoa),
    ja_tem_anexo (na edição: o campo de arquivo já tem anexo e deixa de ser obrigatório no navegador). %>
<% nome = "campos[#{campo.chave}]" %>
<% id = "campo_#{campo.chave}" %>
<% rotulo = campo.obrigatorio? ? "#{campo.rotulo} *" : campo.rotulo %>
<% borda = erro ? "border-[var(--danger-border-strong)] focus:border-[var(--danger-border-strong)]" : "border-[var(--border-subtle)] focus:border-[var(--accent-strong)]" %>
<% entrada = "w-full rounded-xl border bg-[var(--filter-field-bg)] px-4 text-sm text-[var(--text-primary)] outline-none placeholder:text-[var(--text-muted)] #{borda}" %>
<% caixa = "flex items-center gap-3 rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] px-4 py-3 text-sm text-[var(--text-primary)]" %>
<% mascara = campo.tipo == "data" ? "data" : campo.mascara %>
<% dados = mascara ? { controller: "mascara", mascara_tipo_value: mascara, action: "input->mascara#aplicar" } : {} %>

<% if campo.com_fonte? %>
  <% escolhida = Core::Api.opcao_da_fonte(campo.fonte, valor) %>
  <%= render "compartilhado/campo_autocomplete", nome: nome, id: id, rotulo: rotulo, obrigatorio: campo.obrigatorio?, url: ti_opcoes_do_campo_path(campo, solicitante_id: local_assigns[:solicitante_id]),
        valor: escolhida&.dig(:valor), texto: escolhida&.dig(:rotulo), erros: Array(erro), placeholder: campo.exemplo.presence || "Digite sua pesquisa",
        ajuda: campo.ajuda, vazio: "Nada encontrado." %>
<% elsif %w[selecao_unica selecao_multipla sim_nao].include?(campo.tipo) %>
  <% opcoes = campo.tipo == "sim_nao" ? [ %w[Sim sim], %w[Não nao] ] : campo.opcoes.map { |opcao| [ opcao, opcao ] } %>
  <fieldset class="space-y-2" id="<%= id %>">
    <legend class="mb-1.5 text-sm font-medium text-[var(--text-secondary)]"><%= rotulo %></legend>
    <% opcoes.each_with_index do |(texto, valor_da_opcao), indice| %>
      <label class="<%= caixa %>">
        <% if campo.tipo == "selecao_multipla" %>
          <%= check_box_tag "#{nome}[]", valor_da_opcao, Array(valor).include?(valor_da_opcao), id: "#{id}_#{indice}", class: "h-4 w-4" %>
        <% else %>
          <%= radio_button_tag nome, valor_da_opcao, valor.to_s == valor_da_opcao, id: "#{id}_#{indice}", required: campo.obrigatorio?, class: "h-4 w-4" %>
        <% end %>
        <span><%= texto %></span>
      </label>
    <% end %>
    <% if campo.ajuda.present? %><p class="text-xs text-[var(--text-muted)]"><%= campo.ajuda %></p><% end %>
    <% if erro %><p class="text-sm text-[var(--danger-text)]"><%= campo.rotulo %> <%= erro %></p><% end %>
  </fieldset>
<% else %>
  <div class="space-y-1.5">
    <label for="<%= id %>" class="text-sm font-medium text-[var(--text-secondary)]"><%= rotulo %></label>
    <% case campo.tipo %>
    <% when "texto_longo" %>
      <%= text_area_tag nome, valor, id: id, rows: 4, required: campo.obrigatorio?, placeholder: campo.exemplo, class: "#{entrada} min-h-28 py-3" %>
    <% when "selecao" %>
      <%= select_tag nome, options_for_select([ [ "Selecione", "" ] ] + campo.opcoes, valor), id: id, required: campo.obrigatorio?, class: "#{entrada} h-11" %>
    <% when "arquivo", "arquivos" %>
      <%= file_field_tag (campo.tipo == "arquivos" ? "#{nome}[]" : nome), id: id, multiple: campo.tipo == "arquivos", required: campo.obrigatorio? && !local_assigns[:ja_tem_anexo],
            class: "block w-full rounded-xl border bg-[var(--filter-field-bg)] px-3 py-2 text-sm text-[var(--text-primary)] file:mr-3 file:rounded-lg file:border-0 file:bg-[var(--accent-strong)] file:px-3 file:py-1.5 file:text-xs file:font-semibold file:text-white #{borda}" %>
    <% when "numero" %>
      <%= text_field_tag nome, valor, id: id, required: campo.obrigatorio?, placeholder: campo.exemplo, inputmode: "decimal", autocomplete: "off", data: dados, class: "#{entrada} h-11" %>
    <% else %>
      <%= text_field_tag nome, valor, id: id, required: campo.obrigatorio?, autocomplete: "off", data: dados,
            placeholder: campo.exemplo.presence || ("dd/mm/aaaa" if campo.tipo == "data"), inputmode: (mascara ? "numeric" : nil), class: "#{entrada} h-11" %>
    <% end %>
    <% if campo.ajuda.present? %><p class="text-xs text-[var(--text-muted)]"><%= campo.ajuda %></p><% end %>
    <% if erro %><p class="text-sm text-[var(--danger-text)]"><%= campo.rotulo %> <%= erro %></p><% end %>
  </div>
<% end %>
