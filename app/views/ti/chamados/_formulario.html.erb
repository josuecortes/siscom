<%# Painel de abertura de chamado. locals: formulario (Ti::Chamados::Abrir::Formulario), solicitacoes ([[nome, id]]),
    para_outro (bool: a TI abre em nome de outra pessoa, escolhida por busca). %>
<% para_outro = local_assigns[:para_outro] %>
<% solicitante = formulario.solicitante %>
<% url = para_outro ? ti_chamado_para_outro_path : ti_chamados_path %>
<% url_do_painel = para_outro ? new_ti_chamado_para_outro_path : new_ti_chamado_path %>
<% solicitacao = formulario.solicitacao %>
<% erros = formulario.erros.transform_keys(&:to_s) %>
<% rodape = capture { render "compartilhado/rodape_painel", formulario: "formulario_chamado", rotulo: "Abrir chamado" } %>
<% entrada = "h-11 w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] px-4 text-sm text-[var(--text-primary)] outline-none focus:border-[var(--accent-strong)]" %>

<%= render layout: "compartilhado/painel_formulario",
      locals: { sobretitulo: "Novo chamado", titulo: (para_outro ? "Abrir chamado para outra pessoa" : "Abrir chamado"), voltar: (para_outro ? ti_operacao_index_path : ti_chamados_path), rodape: rodape,
                descricao: ("O chamado fica em nome da pessoa escolhida, com o registro de que foi você quem abriu." if para_outro) } do %>
  <%# Em nome de outra pessoa não há lista por trás do painel: ao salvar, a página inteira vai para o chamado. %>
  <%= form_with url: url, id: "formulario_chamado", class: "space-y-5", multipart: true, data: ({ turbo_frame: "_top" } if para_outro) do |f| %>
    <% if erros.any? %>
      <%= render "compartilhado/faixa_aviso", tom: :erro, embutida: true, mensagem: (erros["base"] || "Revise os campos destacados e tente novamente.") %>
    <% end %>

    <% if para_outro %>
      <div data-controller="recarregar-quadro" data-recarregar-quadro-url-value="<%= url_do_painel %>" data-recarregar-quadro-parametro-value="chamado[solicitante_id]">
        <%= render "compartilhado/campo_autocomplete", nome: "chamado[solicitante_id]", id: "chamado_solicitante", rotulo: "Pessoa *", obrigatorio: true,
              url: ti_opcoes_de_usuarios_path, valor: solicitante&.id, texto: solicitante&.nome, acao: "change->recarregar-quadro#recarregar",
              erros: Array(erros["solicitante"]), vazio: "Nenhum usuário encontrado." %>
      </div>
    <% end %>

    <% if formulario.lotacoes.size > 1 %>
      <div class="space-y-1.5">
        <label for="chamado_lotacao_id" class="text-sm font-medium text-[var(--text-secondary)]">Unidade de lotação *</label>
        <%= select_tag "chamado[lotacao_id]",
              options_for_select([ [ "Selecione a unidade", "" ] ] + formulario.lotacoes.map { |l| [ "#{[ l.unidade.sigla, l.unidade.nome ].compact_blank.join(' - ')} (#{l.funcao})", l.id ] }, formulario.lotacao_id),
              id: "chamado_lotacao_id", required: true, data: { parametro: "lotacao_id" }, class: entrada %>
        <p class="text-xs text-[var(--text-muted)]"><%= para_outro ? "A pessoa tem" : "Você tem" %> mais de uma lotação: escolha de qual unidade é este pedido.</p>
        <% if erros["lotacao"] %><p class="text-sm text-[var(--danger-text)]">Unidade de lotação <%= erros["lotacao"] %></p><% end %>
      </div>
    <% elsif formulario.lotacoes.one? %>
      <% lotacao = formulario.lotacoes.first %>
      <div class="space-y-1.5">
        <label for="chamado_unidade" class="text-sm font-medium text-[var(--text-secondary)]">Unidade de lotação</label>
        <input type="text" id="chamado_unidade" readonly value="<%= [ lotacao.unidade.sigla, lotacao.unidade.nome ].compact_blank.join(" - ") %>"
               class="<%= entrada %> text-[var(--text-secondary)]">
        <% if lotacao.funcao.present? %><p class="text-xs text-[var(--text-muted)]"><%= lotacao.funcao %></p><% end %>
      </div>
    <% end %>

    <% if !para_outro || solicitante %>
    <div data-controller="recarregar-quadro" data-recarregar-quadro-url-value="<%= url_do_painel %>"
         data-recarregar-quadro-parametro-value="problema_id" data-recarregar-quadro-incluir-value="#chamado_lotacao_id, #chamado_solicitante_valor">
      <%= render "compartilhado/campo_escolha", nome: "chamado[problema_id]", id: "chamado_problema", rotulo: "Solicitação *", opcoes: solicitacoes,
            valor: solicitacao&.id, em_branco: "Selecione", obrigatorio: true, acao: "change->recarregar-quadro#recarregar",
            erros: Array(erros["solicitacao"]) %>
    </div>
    <% end %>

    <% if solicitacao %>
      <% solicitacao.campos.ativo.ordenados.each do |campo| %>
        <%= render "ti/chamados/campo_dinamico", campo: campo, valor: formulario.respostas&.entrada(campo), erro: erros[campo.chave],
              solicitante_id: (solicitante.id if para_outro) %>
      <% end %>
      <p class="text-sm text-[var(--text-muted)]">Os campos marcados com * são requeridos.</p>
    <% elsif solicitacoes.empty? && (!para_outro || solicitante) %>
      <%= render "compartilhado/faixa_aviso", tom: :erro, embutida: true,
            mensagem: (para_outro ? "Nenhuma solicitação está liberada para esta pessoa. Inclua-a em um perfil de abertura." : "Nenhuma solicitação está liberada para você. Procure a TI.") %>
    <% end %>
  <% end %>
<% end %>
