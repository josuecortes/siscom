<% content_for :title, "Abrir chamado" %>
<% solicitacao = @formulario.solicitacao %>
<% erros = @formulario.erros.transform_keys(&:to_s) %>
<% rodape = capture { render "compartilhado/rodape_painel", formulario: "formulario_chamado", rotulo: "Abrir chamado" } %>
<% entrada = "h-11 w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] px-4 text-sm text-[var(--text-primary)] outline-none focus:border-[var(--accent-strong)]" %>

<%= render layout: "compartilhado/painel_formulario",
      locals: { sobretitulo: "Novo chamado", titulo: "Abrir chamado", voltar: ti_chamados_path, rodape: rodape,
                descricao: "Escolha a solicitação e preencha os dados pedidos." } do %>
  <%= form_with url: ti_chamados_path, id: "formulario_chamado", class: "space-y-5", multipart: true do |f| %>
    <% if erros.any? %>
      <%= render "compartilhado/faixa_aviso", tom: :erro, embutida: true, mensagem: (erros["base"] || "Revise os campos destacados e tente novamente.") %>
    <% end %>

    <% if @formulario.lotacoes.size > 1 %>
      <div class="space-y-1.5">
        <label for="chamado_lotacao_id" class="text-sm font-medium text-[var(--text-secondary)]">Unidade *</label>
        <%= select_tag "chamado[lotacao_id]",
              options_for_select([ [ "Selecione a unidade", "" ] ] + @formulario.lotacoes.map { |l| [ "#{[ l.unidade.sigla, l.unidade.nome ].compact_blank.join(' - ')} (#{l.funcao})", l.id ] }, @formulario.lotacao_id),
              id: "chamado_lotacao_id", required: true, data: { parametro: "lotacao_id" }, class: entrada %>
        <p class="text-xs text-[var(--text-muted)]">Você tem mais de uma lotação: escolha de qual unidade é este pedido.</p>
        <% if erros["lotacao"] %><p class="text-sm text-[var(--danger-text)]">Unidade <%= erros["lotacao"] %></p><% end %>
      </div>
    <% elsif @formulario.lotacoes.one? %>
      <% lotacao = @formulario.lotacoes.first %>
      <div class="space-y-1.5">
        <label for="chamado_unidade" class="text-sm font-medium text-[var(--text-secondary)]">Unidade</label>
        <input type="text" id="chamado_unidade" readonly value="<%= [ lotacao.unidade.sigla, lotacao.unidade.nome ].compact_blank.join(" - ") %>"
               class="<%= entrada %> text-[var(--text-secondary)]">
      </div>
    <% end %>

    <div data-controller="recarregar-quadro" data-recarregar-quadro-url-value="<%= new_ti_chamado_path %>"
         data-recarregar-quadro-parametro-value="problema_id" data-recarregar-quadro-incluir-value="#chamado_lotacao_id">
      <%= render "compartilhado/campo_escolha", nome: "chamado[problema_id]", id: "chamado_problema", rotulo: "Solicitação *", opcoes: @solicitacoes,
            valor: solicitacao&.id, em_branco: "Selecione", obrigatorio: true, acao: "change->recarregar-quadro#recarregar",
            erros: Array(erros["solicitacao"]) %>
    </div>

    <% if solicitacao %>
      <div class="rounded-[var(--radius-card)] border border-[var(--border-subtle)] bg-[var(--surface-subtle)] px-4 py-3 text-sm text-[var(--text-secondary)]">
        <p class="font-semibold text-[var(--text-primary)]"><%= solicitacao.nome %></p>
        <p class="mt-1"><%= solicitacao.descricao %></p>
      </div>

      <% solicitacao.campos.ativo.ordenados.each do |campo| %>
        <%= render "campo_dinamico", campo: campo, valor: @formulario.respostas&.entrada(campo), erro: erros[campo.chave] %>
      <% end %>
      <p class="text-xs text-[var(--text-muted)]">Os campos marcados com * são requeridos.</p>
    <% elsif @solicitacoes.empty? %>
      <%= render "compartilhado/faixa_aviso", tom: :erro, embutida: true, mensagem: "Nenhuma solicitação está liberada para você. Procure a TI." %>
    <% end %>
  <% end %>
<% end %>
