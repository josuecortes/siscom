<% content_for :title, @chamado.codigo %>
<%= render layout: "compartilhado/cabecalho_pagina", locals: { titulo: "Chamado #{@chamado.codigo}", icone: :task, migalha: [ "Meus chamados", ti_chamados_path ] } do %>
  <%= render "compartilhado/acao_cabecalho", rotulo: "Voltar", caminho: ti_chamados_path, secundaria: true %>
<% end %>

<%= turbo_stream_from @chamado %>
<%= render layout: "detalhes", locals: { chamado: @chamado, valores: @valores, eventos: @eventos } do %>
  <% meu = @chamado.solicitante_id == current_user.id %>
  <% botao = "inline-flex h-10 items-center gap-2 rounded-md border border-[var(--border-subtle)] bg-[var(--surface-card)] px-4 text-sm font-medium text-[var(--text-primary)] hover:border-[var(--accent-strong)] hover:text-[var(--accent-strong)]" %>
  <% principal = "inline-flex h-10 items-center gap-2 rounded-md bg-[var(--accent-strong)] px-4 text-sm font-semibold text-white hover:bg-[var(--accent-stronger)]" %>
  <% if meu && @chamado.aguardando_solicitante? %>
    <section class="rounded-[var(--radius-panel)] border border-[var(--border-subtle)] bg-[var(--warning-surface)] px-6 py-5">
      <h2 class="text-sm font-semibold text-[var(--warning-text)]">A TI precisa de uma resposta sua</h2>
      <p class="mt-1 text-sm text-[var(--text-primary)]"><%= @chamado.nota_triagem %></p>
      <div class="mt-3 flex flex-wrap gap-2">
        <%= link_to "Responder", resposta_ti_chamado_path(@chamado), data: { turbo_frame: "painel" }, class: principal %>
        <%= link_to "Corrigir os dados e reenviar", edit_ti_chamado_path(@chamado), data: { turbo_frame: "painel" }, class: botao %>
        <%= link_to "Cancelar chamado", cancelamento_ti_chamado_path(@chamado), data: { turbo_frame: "painel" }, class: botao %>
      </div>
    </section>
  <% elsif meu && @chamado.concluido? %>
    <section class="rounded-[var(--radius-panel)] border border-[var(--border-subtle)] bg-[var(--surface-card)] px-6 py-5 shadow-[var(--shadow-card)]">
      <h2 class="text-sm font-semibold text-[var(--text-primary)]">O atendimento foi concluído</h2>
      <p class="mt-1 text-sm text-[var(--text-secondary)]">Confira se o seu pedido foi resolvido e finalize o chamado com a sua avaliação.</p>
      <div class="mt-3"><%= link_to "Finalizar chamado", finalizacao_ti_chamado_path(@chamado), data: { turbo_frame: "painel" }, class: principal %></div>
    </section>
  <% elsif meu && @chamado.aberto? %>
    <section class="rounded-[var(--radius-panel)] border border-[var(--border-subtle)] bg-[var(--surface-card)] px-6 py-5 shadow-[var(--shadow-card)]">
      <h2 class="text-sm font-semibold text-[var(--text-primary)]">Ninguém pegou este chamado ainda</h2>
      <p class="mt-1 text-sm text-[var(--text-secondary)]">Enquanto isso, você pode corrigir os dados ou cancelar.</p>
      <div class="mt-3 flex flex-wrap gap-2">
        <%= link_to "Editar chamado", edit_ti_chamado_path(@chamado), data: { turbo_frame: "painel" }, class: botao %>
        <%= link_to "Cancelar chamado", cancelamento_ti_chamado_path(@chamado), data: { turbo_frame: "painel" }, class: botao %>
      </div>
    </section>
  <% end %>
<% end %>
