<% content_for :title, "Estatísticas da TI" %>
<% e = @estatisticas %>
<% campo = "h-11 w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] px-4 text-sm text-[var(--text-primary)] outline-none focus:border-[var(--accent-strong)]" %>
<% rotulo = "text-sm font-medium text-[var(--text-secondary)]" %>
<% data = { controller: "mascara", mascara_tipo_value: "data", action: "input->mascara#aplicar" } %>
<% consulta = { inicio: DataBr.formatar(e.inicio), fim: DataBr.formatar(e.fim), categoria_id: e.categoria&.id, tecnico_id: e.tecnico&.id }.compact %>
<% cartao = "rounded-[var(--radius-panel)] border border-[var(--border-subtle)] bg-[var(--surface-card)] shadow-[var(--shadow-card)]" %>

<%= render layout: "compartilhado/cabecalho_pagina", locals: { titulo: "Estatísticas", icone: :chart_pie, migalha: [ "TI", ti_estatisticas_path ] } do %>
  <%= render "compartilhado/acao_cabecalho", rotulo: "Exportar Excel", icone: :cloud_download, caminho: ti_estatisticas_path(consulta.merge(format: :xlsx)), opcoes: { data: { turbo: false } } %>
<% end %>

<section class="mt-6 <%= cartao %>">
  <%= form_with url: ti_estatisticas_path, method: :get, class: "border-b border-[var(--border-subtle)] px-6 py-5" do |f| %>
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-[180px_180px_1fr_1fr_auto] lg:items-end">
      <div class="space-y-1.5">
        <label for="inicio" class="<%= rotulo %>">Abertos de</label>
        <%= text_field_tag :inicio, consulta[:inicio], placeholder: "dd/mm/aaaa", inputmode: "numeric", maxlength: 10, autocomplete: "off", data: data, class: campo %>
      </div>
      <div class="space-y-1.5">
        <label for="fim" class="<%= rotulo %>">Até</label>
        <%= text_field_tag :fim, consulta[:fim], placeholder: "dd/mm/aaaa", inputmode: "numeric", maxlength: 10, autocomplete: "off", data: data, class: campo %>
      </div>
      <div class="space-y-1.5">
        <label for="categoria_id" class="<%= rotulo %>">Categoria</label>
        <%= select_tag :categoria_id, options_for_select([ [ "Todas", "" ] ] + Ti::Categoria.order(:nome).pluck(:nome, :id), e.categoria&.id), class: campo %>
      </div>
      <%= render "compartilhado/campo_autocomplete", nome: "tecnico_id", id: "filtro_tecnico", rotulo: "Técnico", flutuante: true, url: tecnicos_ti_estatisticas_path,
            valor: e.tecnico&.id, texto: e.tecnico&.nome, placeholder: "Todos", vazio: "Nenhum técnico com chamados." %>
      <div class="flex flex-row gap-2">
        <button type="submit" title="Gerar estatísticas" aria-label="Gerar estatísticas"
                class="inline-flex h-11 w-11 cursor-pointer items-center justify-center rounded-xl bg-[var(--accent-strong)] text-white hover:bg-[var(--accent-stronger)]"><%= icone(:search) %></button>
        <%= link_to ti_estatisticas_path, title: "Limpar filtros", aria: { label: "Limpar filtros" },
              class: "inline-flex h-11 w-11 items-center justify-center rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] text-[var(--text-secondary)] hover:border-[var(--accent-strong)]" do %>
          <%= icone(:x) %>
        <% end %>
      </div>
    </div>
  <% end %>

  <%= render "compartilhado/resumo_tabela", texto: "Chamados abertos de #{DataBr.formatar(e.inicio)} a #{DataBr.formatar(e.fim)}, incluindo os migrados do siscom antigo" %>

  <dl class="grid gap-3 px-6 py-5 sm:grid-cols-2 lg:grid-cols-3" id="resumo_das_estatisticas">
    <% e.resumo.each do |nome, valor| %>
      <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-subtle)] px-4 py-3">
        <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--text-muted)]"><%= nome %></dt>
        <dd class="mt-1 text-xl font-semibold text-[var(--text-primary)]"><%= valor.is_a?(Numeric) ? number_with_delimiter(valor) : valor %></dd>
      </div>
    <% end %>
  </dl>
</section>

<div class="mt-6 grid gap-6 xl:grid-cols-2">
  <% e.secoes.each do |secao| %>
    <section class="<%= cartao %> <%= "xl:col-span-2" if secao.chave == "tecnico" %>" id="estatisticas_<%= secao.chave %>">
      <h2 class="border-b border-[var(--border-subtle)] px-6 py-4 text-base font-semibold text-[var(--text-primary)]"><%= secao.titulo %></h2>
      <div class="overflow-x-auto">
        <table class="collection-table">
          <thead>
            <tr><% secao.colunas.each do |coluna| %><th scope="col"><%= coluna %></th><% end %></tr>
          </thead>
          <tbody>
            <% secao.linhas.each do |linha| %>
              <tr><% linha.each_with_index do |valor, indice| %><td class="<%= "!whitespace-normal" if indice.zero? %>"><%= valor.is_a?(Numeric) ? number_with_delimiter(valor) : valor %></td><% end %></tr>
            <% end %>
            <% if secao.linhas.empty? %>
              <tr><td colspan="<%= secao.colunas.size %>" class="px-6 py-8 text-center text-sm text-[var(--text-secondary)]">Nenhum chamado no período.</td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>
</div>
