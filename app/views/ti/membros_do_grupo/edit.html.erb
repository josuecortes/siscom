<% content_for :title, "Membros do grupo" %>
<% rodape = capture { render "compartilhado/rodape_painel", formulario: "formulario_membros", rotulo: "Salvar membros" } %>
<% nomes = Core::Api.modulo(:ti).papeis.transform_values(&:nome) %>

<%= render layout: "compartilhado/painel_formulario",
      locals: { sobretitulo: "Membros", titulo: "Gerenciar membros de #{@grupo.nome}", voltar: ti_grupos_tecnicos_path, rodape: rodape,
                descricao: "Só aparece quem já tem permissão na TI (administrador, supervisor, triador ou técnico)." } do %>
  <%= form_with url: ti_grupo_tecnico_membros_path(@grupo), method: :patch, id: "formulario_membros", class: "space-y-5" do |f| %>
    <% if @erro.present? %>
      <%= render "compartilhado/faixa_aviso", tom: :erro, embutida: true, mensagem: @erro %>
    <% end %>

    <fieldset class="space-y-2">
      <legend class="mb-2 text-sm font-medium text-[var(--text-secondary)]">Membros do grupo</legend>
      <%= hidden_field_tag "user_ids[]", "", id: nil %>
      <% @elegiveis.each do |usuario| %>
        <label class="flex items-start gap-3 rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] px-4 py-3 text-sm">
          <%= check_box_tag "user_ids[]", usuario.id, @marcados.include?(usuario.id), id: "membro_#{usuario.id}", class: "mt-0.5 h-4 w-4" %>
          <span class="min-w-0">
            <span class="block font-semibold text-[var(--text-primary)]"><%= usuario.nome %></span>
            <span class="block break-words text-[var(--text-secondary)]"><%= @papeis.fetch(usuario.id, []).map { |papel| nomes[papel] || papel }.join(", ") %> · <%= usuario.email %></span>
          </span>
        </label>
      <% end %>
      <% if @elegiveis.empty? %>
        <p class="text-sm text-[var(--text-secondary)]">Ninguém tem permissão na TI ainda. Conceda em TI → Administração → Permissões.</p>
      <% end %>
    </fieldset>
  <% end %>
<% end %>
