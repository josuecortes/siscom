<% content_for :title, "Mudar etapa" %>
<%# Escolha da mudança de etapa: cada opção abre o painel da ação, que pede a anotação. %>
<%= render layout: "compartilhado/painel_formulario",
      locals: { sobretitulo: "Operação", titulo: "Mudar etapa #{@chamado.codigo}", voltar: ti_operacao_index_path, rodape: render("compartilhado/rodape_fechar"),
                descricao: "#{@chamado.problema.nome} · #{@chamado.solicitante_nome}. Etapa atual: #{@chamado.nome_do_status}." } do %>
  <ul class="space-y-2" id="etapas_do_chamado">
    <% @acoes.each do |acao| %>
      <li>
        <%= link_to acao_ti_operacao_path(@chamado, acao.chave), data: { turbo_frame: "painel" },
              class: "flex items-center gap-3 rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] px-4 py-3 text-sm font-semibold text-[var(--text-primary)] hover:border-[var(--accent-strong)] hover:text-[var(--accent-strong)]" do %>
          <%= icone(acao.icone) %> <span><%= acao.rotulo %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
