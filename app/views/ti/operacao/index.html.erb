<% content_for :title, "Operação" %>

<%= render layout: "compartilhado/cabecalho_pagina", locals: { titulo: "Operação", icone: :group, migalha: [ "TI", ti_operacao_index_path ] } do %>
<% end %>

<%= turbo_stream_from "ti_operacao" %>
<section class="mt-6 rounded-[var(--radius-panel)] border border-[var(--border-subtle)] bg-[var(--surface-card)] shadow-[var(--shadow-card)]">
  <%= render "compartilhado/filtro_busca_status", url: ti_operacao_index_path, quadro: "operacao_lista", rotulo_busca: "Buscar por código, solicitação, solicitante ou unidade",
        exemplo: "Ex.: TI-000001 ou Maria", busca: @filtros[:q], status: @filtros[:status],
        opcoes_status: Ti::OperacaoController::VISOES.invert.to_a, titulo_filtrar: "Filtrar chamados" %>

  <%= turbo_frame_tag "operacao_lista", data: { turbo_action: "advance" } do %>
    <%= render "compartilhado/resumo_tabela", texto: "#{@pagy.count} chamado(s) encontrado(s)" %>

    <div class="overflow-x-auto">
      <table class="collection-table min-w-[1100px]">
        <thead>
          <tr>
            <th scope="col">Código</th>
            <th scope="col">Solicitação</th>
            <th scope="col">Solicitante</th>
            <th scope="col">Aberto em</th>
            <th scope="col">Prioridade</th>
            <th scope="col">Status</th>
            <th scope="col">Responsável</th>
            <th scope="col" class="!pl-2">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% @chamados.each do |chamado| %>
            <tr id="<%= dom_id(chamado) %>">
              <td class="font-semibold text-[var(--text-primary)]">
                <%= link_to chamado.codigo, ti_operacao_path(chamado), class: "hover:text-[var(--accent-strong)]", data: { turbo_frame: "painel" } %>
              </td>
              <td class="!whitespace-normal"><%# solicitação e solicitante quebram a linha: as ações têm de caber sem rolagem %>
                <p class="font-semibold text-[var(--text-primary)]">
                  <%= link_to chamado.problema.nome, ti_operacao_path(chamado), class: "hover:text-[var(--accent-strong)]", data: { turbo_frame: "painel" } %>
                </p>
              </td>
              <td class="!whitespace-normal">
                <div class="min-w-0">
                  <p><%= chamado.solicitante_nome %></p>
                  <% if chamado.unidade_nome.present? %><p class="text-sm text-[var(--text-secondary)]"><%= chamado.unidade_nome %></p><% end %>
                </div>
              </td>
              <td class="whitespace-nowrap"><%= l(chamado.aberto_em, format: "%d/%m/%Y %H:%M") %></td>
              <td><%= render "compartilhado/selo", texto: chamado.nome_da_prioridade, tom: (chamado.prioridade_normal? ? :neutro : :atencao) %></td>
              <td><%= selo_do_status(chamado) %></td>
              <td><%= chamado.responsavel&.nome || (chamado.em_triagem? && chamado.triador ? "#{chamado.triador.nome} (triagem)" : "Não atribuído") %></td>
              <td class="!pl-2 !pr-4"><%= render "ti/chamados/acoes", chamado: chamado, visao: :operacao %></td>
            </tr>
          <% end %>
          <% if @chamados.empty? %>
            <tr><td colspan="8" class="px-6 py-10 text-center text-sm text-[var(--text-secondary)]">Nenhum chamado nesta visão.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render "compartilhado/paginacao", pagy: @pagy, quadro: "operacao_lista" %>
  <% end %>
</section>
