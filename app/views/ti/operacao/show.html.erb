<% content_for :title, @chamado.codigo %>

<%= render layout: "compartilhado/cabecalho_pagina", locals: { titulo: "Chamado #{@chamado.codigo}", icone: :task, migalha: [ "Operação", ti_operacao_index_path ] } do %>
  <%= render "compartilhado/acao_cabecalho", rotulo: "Voltar", caminho: ti_operacao_index_path, secundaria: true %>
<% end %>

<%= turbo_stream_from @chamado %>
<%= render layout: "ti/chamados/detalhes", locals: { chamado: @chamado, valores: @valores, eventos: @eventos, supervisao: Ti::Chamados::Acesso.supervisiona?(current_user) } do %>
  <% if @acoes.any? %>
    <section class="rounded-[var(--radius-panel)] border border-[var(--border-subtle)] bg-[var(--surface-card)] px-6 py-5 shadow-[var(--shadow-card)]" id="acoes_do_chamado">
      <h2 class="text-sm font-semibold text-[var(--text-primary)]">O que fazer</h2>
      <div class="mt-3 flex flex-wrap gap-2">
        <% botao = "inline-flex h-10 cursor-pointer items-center gap-2 rounded-md border border-[var(--border-subtle)] bg-[var(--surface-card)] px-4 text-sm font-medium text-[var(--text-primary)] hover:border-[var(--accent-strong)] hover:text-[var(--accent-strong)]" %>
        <% @acoes.each do |acao| %>
          <% if acao.pede_nota %>
            <%= link_to acao_ti_operacao_path(@chamado, acao.chave), class: botao, data: { turbo_frame: "painel" } do %><%= icone(acao.icone) %> <%= acao.rotulo %><% end %>
          <% else %>
            <%= button_to acao_ti_operacao_path(@chamado, acao.chave), method: :post, class: "#{botao} border-transparent bg-[var(--accent-strong)] !text-white hover:bg-[var(--accent-stronger)]", form: { data: { turbo_frame: "_top" } } do %><%= icone(acao.icone) %> <%= acao.rotulo %><% end %>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>
<% end %>
