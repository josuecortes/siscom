<% content_for :title, "Perfis de abertura" %>
<% rodape = capture { render "compartilhado/rodape_painel", formulario: "formulario_perfis", rotulo: "Salvar perfis" } %>

<%= render layout: "compartilhado/painel_formulario",
      locals: { sobretitulo: "Perfis", titulo: "Gerenciar perfis de #{@usuario.nome}", voltar: ti_permissoes_path, rodape: rodape,
                descricao: "O perfil de abertura define quais solicitações o usuário pode abrir. Os perfis padrão já valem para todos e não aparecem aqui." } do %>
  <%= form_with url: ti_permissao_perfis_abertura_path(@usuario), method: :patch, id: "formulario_perfis", class: "space-y-5" do |f| %>
    <% if @erro.present? %>
      <%= render "compartilhado/faixa_aviso", tom: :erro, embutida: true, mensagem: @erro %>
    <% end %>

    <fieldset class="space-y-2">
      <legend class="mb-2 text-sm font-medium text-[var(--text-secondary)]">Perfis de abertura</legend>
      <%= hidden_field_tag "perfil_ids[]", "", id: nil %>
      <% @perfis.each do |perfil| %>
        <label class="flex items-start gap-3 rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] px-4 py-3 text-sm">
          <%= check_box_tag "perfil_ids[]", perfil.id, @marcados.include?(perfil.id), id: "perfil_#{perfil.id}", class: "mt-0.5 h-4 w-4" %>
          <span class="min-w-0">
            <span class="block font-semibold text-[var(--text-primary)]"><%= perfil.nome %></span>
            <% if perfil.descricao.present? %><span class="block text-[var(--text-secondary)]"><%= perfil.descricao %></span><% end %>
          </span>
        </label>
      <% end %>
      <% if @perfis.empty? %>
        <p class="text-sm text-[var(--text-secondary)]">Nenhum perfil de abertura ativo. Cadastre em TI → Administração → Perfis de abertura.</p>
      <% end %>
    </fieldset>
  <% end %>
<% end %>
