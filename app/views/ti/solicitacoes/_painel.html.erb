<% nova = @solicitacao.new_record? %>
<% rodape = capture { render "compartilhado/rodape_painel", formulario: "formulario_solicitacao", rotulo: (nova ? "Salvar solicitação" : "Salvar alterações") } %>
<% caixa = "flex items-start gap-3 rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] px-4 py-3 text-sm text-[var(--text-secondary)]" %>

<%= render layout: "compartilhado/painel_formulario",
      locals: { sobretitulo: "Solicitações", titulo: (nova ? "Nova solicitação" : "Editar solicitação"), voltar: ti_solicitacoes_path, rodape: rodape,
                descricao: "É o que o usuário escolhe ao abrir um chamado. Depois de salvar, marque na lista quem pode abrir e quem atende." } do %>
  <%= form_with model: @solicitacao, scope: :solicitacao, url: (nova ? ti_solicitacoes_path : ti_solicitacao_path(@solicitacao)), id: "formulario_solicitacao", class: "space-y-5" do |f| %>
    <% if @solicitacao.errors.any? %>
      <%= render "compartilhado/faixa_aviso", tom: :erro, embutida: true, mensagem: (@solicitacao.errors[:base].first || "Revise os campos destacados e tente novamente.") %>
    <% end %>

    <%= render "compartilhado/campo_escolha", nome: "solicitacao[categoria_id]", id: "solicitacao_categoria", rotulo: "Categoria *", opcoes: @categorias,
          valor: @solicitacao.categoria_id, em_branco: "Selecione", obrigatorio: true,
          erros: (@solicitacao.errors[:categoria].any? ? [ "deve ser escolhida" ] : []) %>
    <%= render "compartilhado/campo", f: f, campo: :nome, rotulo: "Nome *", html: { required: true, maxlength: 120 } %>
    <%= render "compartilhado/campo", f: f, campo: :descricao, rotulo: "Resumo *", tipo: :textarea, html: { required: true, maxlength: 500 } %>
    <%= render "compartilhado/campo", f: f, campo: :prioridade_padrao, rotulo: "Prioridade padrão", tipo: :select, opcoes: Ti::Problema::PRIORIDADES.invert.to_a %>

    <label class="<%= caixa %>">
      <%= f.check_box :exige_triagem, class: "mt-0.5 h-4 w-4" %>
      <span>
        <span class="block font-semibold text-[var(--text-primary)]">Exige triagem</span>
        <span class="block">O chamado passa por um triador antes de ir para o técnico.</span>
      </span>
    </label>
    <label class="<%= caixa %>">
      <%= f.check_box :permite_varios_abertos, class: "mt-0.5 h-4 w-4" %>
      <span>
        <span class="block font-semibold text-[var(--text-primary)]">Permite abrir mais de um chamado ao mesmo tempo</span>
        <span class="block">Desmarcado, o usuário só abre outro chamado desta solicitação depois que o anterior terminar.</span>
      </span>
    </label>

    <p class="text-sm text-[var(--text-muted)]">Os campos marcados com * são requeridos.</p>
  <% end %>
<% end %>
