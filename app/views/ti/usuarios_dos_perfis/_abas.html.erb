<%# Abas da tela Perfis de abertura: a lista de perfis (como sempre foi) e a dos usuários. As duas são listas diferentes,
    cada uma com a sua busca, por isso ficam sempre visíveis (não viram "Resultado" ao buscar). locals: atual ("perfis" ou "usuarios") %>
<% aba = "group inline-flex min-w-fit items-center gap-2 border-b-2 border-transparent px-3 py-3 text-sm font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] aria-[current]:border-[var(--accent-strong)] aria-[current]:text-[var(--text-primary)]" %>
<nav class="border-b border-[var(--border-subtle)] px-4 sm:px-6" aria-label="Perfis de abertura">
  <div class="flex gap-1 overflow-x-auto [scrollbar-width:none]">
    <%= link_to "Perfis", ti_perfis_abertura_path, aria: { current: (atual == "perfis" ? "page" : nil) }, class: aba %>
    <%= link_to "Usuários", ti_usuarios_dos_perfis_path, aria: { current: (atual == "usuarios" ? "page" : nil) }, class: aba %>
  </div>
</nav>
