<%# Painel de vínculos no formato do seed: campo de busca para adicionar e lista com × para remover.
    Cada mudança vale na hora; "Concluir" fecha e atualiza a lista por baixo.
    locals: sobretitulo, titulo, descricao, voltar (caminho da lista), erro, aviso,
            adicionar: { url:, campo: (name do campo), rotulo:, opcoes: (endpoint do autocomplete), vazio: } ou nil,
            itens: [{ titulo:, detalhe:, remover: (params do DELETE), rotulo_remover: }], remover_url, total,
            rotulo_lista (ex.: "Usuários do perfil"), vazio (texto sem itens),
            busca: { url:, valor: } ou nil (filtro da lista, quando ela pode ser grande), nota (texto extra) %>
<% rodape = capture do %>
  <%= link_to "Concluir", voltar, data: { turbo_frame: "_top" },
        class: "inline-flex h-10 items-center justify-center rounded-md bg-[var(--accent-strong)] px-4 text-sm font-semibold text-white hover:bg-[var(--accent-stronger)]" %>
<% end %>
<% entrada = "h-11 w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] px-4 text-sm text-[var(--text-primary)] outline-none placeholder:text-[var(--text-muted)] focus:border-[var(--accent-strong)]" %>

<%= render layout: "compartilhado/painel_formulario", locals: { sobretitulo: sobretitulo, titulo: titulo, voltar: voltar, rodape: rodape, descricao: descricao } do %>
  <div class="space-y-5">
    <% if local_assigns[:erro].present? %>
      <%= render "compartilhado/faixa_aviso", tom: :erro, embutida: true, mensagem: erro %>
    <% elsif local_assigns[:aviso].present? %>
      <%= render "compartilhado/faixa_aviso", tom: :sucesso, embutida: true, mensagem: aviso %>
    <% end %>

    <% if local_assigns[:adicionar] %>
      <%= form_with url: adicionar[:url], method: :post, class: "space-y-3" do %>
        <%= render "compartilhado/campo_autocomplete", nome: adicionar[:campo], id: "novo_vinculo", rotulo: adicionar[:rotulo], obrigatorio: true,
              url: adicionar[:opcoes], vazio: adicionar[:vazio] %>
        <button type="submit" class="inline-flex h-10 cursor-pointer items-center gap-2 rounded-md border border-[var(--border-subtle)] px-4 text-sm font-semibold text-[var(--text-primary)] hover:border-[var(--accent-strong)] hover:text-[var(--accent-strong)]"><%= icone(:plus) %> Adicionar</button>
      <% end %>
    <% end %>
    <% if local_assigns[:nota].present? %><p class="text-sm text-[var(--text-secondary)]"><%= nota %></p><% end %>

    <div>
      <p class="mb-2 text-sm font-medium text-[var(--text-secondary)]"><%= rotulo_lista %> (<%= total %>)</p>
      <% if local_assigns[:busca] %>
        <%= form_with url: busca[:url], method: :get, class: "mb-3 flex gap-2" do %>
          <%= text_field_tag :q, busca[:valor], placeholder: "Filtrar esta lista", autocomplete: "off", aria: { label: "Filtrar esta lista" }, class: entrada %>
          <button type="submit" title="Filtrar" aria-label="Filtrar" class="inline-flex h-11 w-11 shrink-0 cursor-pointer items-center justify-center rounded-xl border border-[var(--border-subtle)] text-[var(--text-secondary)] hover:border-[var(--accent-strong)]"><%= icone(:search) %></button>
        <% end %>
      <% end %>
      <ul class="space-y-2" id="lista_de_vinculos">
        <% itens.each do |item| %>
          <li class="flex items-center justify-between gap-3 rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] px-4 py-3 text-sm">
            <span class="min-w-0">
              <span class="block break-words font-semibold text-[var(--text-primary)]"><%= item[:titulo] %></span>
              <% if item[:detalhe].present? %><span class="block break-words text-[var(--text-secondary)]"><%= item[:detalhe] %></span><% end %>
            </span>
            <%= button_to remover_url, method: :delete, params: item[:remover], form: { class: "shrink-0" },
                  title: "Remover #{item[:titulo]}", aria: { label: "Remover #{item[:titulo]}" },
                  class: "inline-flex h-9 w-9 cursor-pointer items-center justify-center rounded-md border border-[var(--border-subtle)] text-[var(--text-secondary)] hover:border-[var(--danger-border-strong)] hover:text-[var(--danger-text)]" do %><%= icone(:x) %><% end %>
          </li>
        <% end %>
        <% if itens.empty? %>
          <li class="rounded-xl border border-dashed border-[var(--border-subtle)] px-4 py-6 text-sm text-[var(--text-secondary)]"><%= vazio %></li>
        <% end %>
      </ul>
      <% if total > itens.size && itens.any? %>
        <p class="mt-2 text-xs text-[var(--text-muted)]">Mostrando <%= itens.size %> de <%= total %>. Use o filtro para encontrar os demais.</p>
      <% end %>
    </div>
  </div>
<% end %>
