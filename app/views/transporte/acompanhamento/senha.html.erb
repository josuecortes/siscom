<% content_for :title, "Painel de transporte" %>
<section class="w-full max-w-md rounded-[var(--radius-panel)] border border-[var(--border-subtle)] bg-[var(--surface-card)] p-8 shadow-[var(--shadow-card)]">
  <h1 class="text-xl font-semibold text-[var(--text-primary)]">Painel de transporte</h1>
  <p class="mt-2 text-sm text-[var(--text-secondary)]">Informe a senha de acesso para visualizar o painel.</p>
  <%= form_with url: transporte_acompanhamento_path, method: :post, class: "mt-5 space-y-4" do %>
    <% if @erro.present? %>
      <%= render "compartilhado/faixa_aviso", tom: :erro, embutida: true, mensagem: @erro %>
    <% end %>
    <div class="space-y-1.5">
      <label for="senha" class="text-sm font-medium text-[var(--text-secondary)]">Senha de acesso</label>
      <%= password_field_tag :senha, nil, required: true, autofocus: true, autocomplete: "off",
            class: "h-11 w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] px-4 text-sm text-[var(--text-primary)] outline-none focus:border-[var(--accent-strong)]" %>
    </div>
    <button type="submit" class="inline-flex h-11 w-full cursor-pointer items-center justify-center rounded-xl bg-[var(--accent-strong)] px-5 text-sm font-semibold text-white hover:bg-[var(--accent-stronger)]">Abrir painel</button>
  <% end %>
</section>
