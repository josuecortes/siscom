<% content_for :title, "Painel de transporte" %>
<%# Painel de TV (porta de transport-public-tracking-board.tsx): escuro, para ser lido de longe. Cada cartão
    tem a cor do nível de urgência (classes .tv-* em application.css). Atualiza na hora quando algo muda na
    operação (Turbo Streams) e a cada N segundos (Stimulus painel-tv), com o relógio andando sozinho. %>
<%= turbo_stream_from "transporte_operacao" %>
<% agora = @quadro.agora %>
<% contagem = @quadro.contagem %>
<% hora = ->(valor) { valor ? l(valor, format: (valor.to_date == agora.to_date ? "%H:%M" : "%d/%m %H:%M")) : "—" } %>
<% nomes = { "critico" => "Atrasado", "urgente" => "Falta pouco", "atencao" => "Atenção", "normal" => "No prazo" } %>

<div class="tv-painel" data-controller="painel-tv" data-painel-tv-intervalo-value="<%= Transporte::AcompanhamentoController::ATUALIZA_A_CADA %>">
  <header class="tv-cabecalho">
    <div class="min-w-0">
      <p class="tv-sobretitulo">Transporte</p>
      <h1 class="tv-titulo">Acompanhamento em tempo real</h1>
    </div>

    <ul class="tv-resumo" aria-label="Resumo por urgência">
      <% nomes.each do |nivel, nome| %>
        <li class="tv-resumo-item" data-nivel="<%= nivel %>" data-vazio="<%= contagem.fetch(nivel, 0).zero? %>">
          <span class="tv-resumo-numero"><%= contagem.fetch(nivel, 0) %></span>
          <span><%= nome %></span>
        </li>
      <% end %>
    </ul>

    <div class="tv-relogio">
      <p class="tv-hora" data-painel-tv-target="hora"><%= l(agora, format: "%H:%M:%S") %></p>
      <p class="tv-data" data-painel-tv-target="data"><%= l(agora, format: "%d/%m/%Y") %></p>
      <p class="tv-atualiza">Atualiza em <strong data-painel-tv-target="contagem"><%= Transporte::AcompanhamentoController::ATUALIZA_A_CADA %> s</strong></p>
      <div class="tv-trilho" aria-hidden="true"><div class="tv-barra" data-painel-tv-target="barra"></div></div>
    </div>
  </header>

  <main class="tv-colunas">
    <% @quadro.colunas.each do |coluna| %>
      <% graves = coluna.itens.count { |item| item.nivel == "critico" } %>
      <section class="tv-coluna" id="tv_<%= coluna.chave %>">
        <h2 class="tv-coluna-titulo">
          <span><%= coluna.titulo %></span>
          <span class="tv-contadores">
            <% if graves.positive? %><span class="tv-contador" data-nivel="critico" title="Atrasados"><%= graves %></span><% end %>
            <span class="tv-contador" data-total><%= coluna.itens.size %></span>
          </span>
        </h2>
        <ul class="tv-lista">
          <% coluna.itens.each do |item| %>
            <li class="tv-cartao" data-nivel="<%= item.nivel %>">
              <div class="tv-cartao-topo">
                <p class="tv-codigo"><%= item.codigo %></p>
                <p class="tv-horario"><%= hora.call(item.horario) %></p>
              </div>
              <p class="tv-nome"><%= item.nome %></p>
              <p class="tv-detalhe"><%= item.detalhe %></p>
              <% if item.aviso %><p class="tv-aviso"><span class="tv-ponto" aria-hidden="true"></span><%= item.aviso %></p><% end %>
            </li>
          <% end %>
          <% if coluna.itens.empty? %><li class="tv-vazio"><%= coluna.vazio %></li><% end %>
        </ul>
      </section>
    <% end %>
  </main>

  <footer class="tv-rodape">
    <ul class="tv-legenda" aria-label="Legenda das cores">
      <li data-nivel="critico"><span class="tv-ponto"></span>Vermelho: passou da hora, alguém está esperando ou ficou sem resposta</li>
      <li data-nivel="urgente"><span class="tv-ponto"></span>Laranja: falta pouco</li>
      <li data-nivel="atencao"><span class="tv-ponto"></span>Amarelo: convém olhar</li>
      <li data-nivel="normal"><span class="tv-ponto"></span>Cinza: no prazo</li>
    </ul>
    <%= button_to "Sair do painel", transporte_acompanhamento_path, method: :delete, class: "tv-sair" %>
  </footer>
</div>
