<% novo = @motorista.new_record? %>
<% rodape = capture { render "compartilhado/rodape_painel", formulario: "formulario_motorista", rotulo: (novo ? "Cadastrar motorista" : "Salvar motorista") } %>

<%= render layout: "compartilhado/painel_formulario",
      locals: { sobretitulo: (novo ? "Novo motorista" : "Editar motorista"), titulo: (novo ? "Cadastrar motorista" : "Atualizar motorista"),
                voltar: transporte_motoristas_path, rodape: rodape,
                descricao: (novo ? "O motorista entra no sistema com a própria conta para iniciar e finalizar os serviços. Se o e-mail ainda não tiver conta, ela é criada agora." : @motorista.user.email) } do %>
  <%= form_with model: @motorista, scope: :motorista, url: (novo ? transporte_motoristas_path : transporte_motorista_path(@motorista)), id: "formulario_motorista", class: "space-y-5" do |f| %>
    <% if @motorista.errors.any? %>
      <%= render "compartilhado/faixa_aviso", tom: :erro, embutida: true, mensagem: (@motorista.errors[:base].first || "Revise os campos destacados e tente novamente.") %>
    <% end %>

    <%= render "compartilhado/campo", f: f, campo: :nome, rotulo: "Nome completo *", html: { required: true, maxlength: 120 } %>
    <% if novo %>
      <div class="space-y-1.5">
        <label for="motorista_email" class="text-sm font-medium text-[var(--text-secondary)]">E-mail da conta *</label>
        <%= email_field_tag "motorista[email]", params.dig(:motorista, :email), id: "motorista_email", required: true, autocomplete: "off",
              class: "h-11 w-full rounded-xl border bg-[var(--filter-field-bg)] px-4 text-sm text-[var(--text-primary)] outline-none #{@motorista.errors[:email].any? ? "border-[var(--danger-border-strong)]" : "border-[var(--border-subtle)] focus:border-[var(--accent-strong)]"}" %>
        <% @motorista.errors[:email].each do |mensagem| %><p class="text-sm text-[var(--danger-text)]">E-mail <%= mensagem %></p><% end %>
      </div>
    <% end %>
    <%= render "compartilhado/campo", f: f, campo: :cpf, rotulo: "CPF *",
          html: { required: true, value: Cpf.formatar(@motorista.cpf), inputmode: "numeric", data: { controller: "mascara", mascara_tipo_value: "cpf", action: "input->mascara#aplicar" } } %>
    <%= render "compartilhado/campo_data", f: f, campo: :data_nascimento, rotulo: "Data de nascimento *", html: { required: true } %>
    <%= render "compartilhado/campo", f: f, campo: :cnh_numero, rotulo: "Número da CNH *", html: { required: true, maxlength: 20 } %>
    <%= render "compartilhado/campo", f: f, campo: :cnh_categoria, rotulo: "Categoria da CNH *", tipo: :select, opcoes: [ [ "Selecione", "" ] ] + Transporte::Motorista::CATEGORIAS, html: { required: true } %>
    <%= render "compartilhado/campo_data", f: f, campo: :cnh_validade, rotulo: "Validade da CNH *", html: { required: true } %>

    <p class="text-xs text-[var(--text-muted)]">Os campos marcados com * são requeridos.</p>
  <% end %>
<% end %>
