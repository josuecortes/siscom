<% content_for :title, "Conta criada" %>
<% rodape = capture do %>
  <%= link_to "Concluir", transporte_motoristas_path, data: { turbo_frame: "_top" },
        class: "inline-flex h-10 items-center justify-center rounded-md bg-[var(--accent-strong)] px-4 text-sm font-semibold text-white hover:bg-[var(--accent-stronger)]" %>
<% end %>

<%= render layout: "compartilhado/painel_formulario",
      locals: { sobretitulo: "Motorista cadastrado", titulo: "Conta de acesso criada", voltar: transporte_motoristas_path, rodape: rodape,
                descricao: "Entregue esta senha a #{@motorista.nome}. Ela não será mostrada de novo e precisa ser trocada no primeiro acesso." } do %>
  <div class="rounded-[var(--radius-card)] border border-[var(--border-subtle)] bg-[var(--surface-subtle)] px-5 py-4">
    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--text-muted)]">E-mail</p>
    <p class="mt-1 break-all text-sm text-[var(--text-primary)]"><%= @motorista.user.email %></p>
    <p class="mt-4 text-xs font-semibold uppercase tracking-[0.16em] text-[var(--text-muted)]">Senha temporária</p>
    <p class="mt-1 select-all font-mono text-2xl font-semibold tracking-[0.12em] text-[var(--text-primary)]" data-senha-temporaria><%= @motorista.senha_temporaria %></p>
  </div>
<% end %>
