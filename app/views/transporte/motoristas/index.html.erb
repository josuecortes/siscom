<% content_for :title, "Motoristas" %>

<%= render layout: "compartilhado/cabecalho_pagina", locals: { titulo: "Motoristas", icone: :people, migalha: [ "Transporte", transporte_motoristas_path ] } do %>
  <%= render "compartilhado/acao_cabecalho", rotulo: "Novo motorista", icone: :plus, caminho: new_transporte_motorista_path, opcoes: { data: { turbo_frame: "painel" } } %>
<% end %>

<section class="mt-6 rounded-[var(--radius-panel)] border border-[var(--border-subtle)] bg-[var(--surface-card)] shadow-[var(--shadow-card)]">
  <%= render "compartilhado/filtro_busca_status", url: transporte_motoristas_path, quadro: "motoristas_lista", rotulo_busca: "Buscar por nome, CPF ou CNH",
        exemplo: "Ex.: João ou 529.982", busca: @filtros[:q], status: @filtros[:status],
        opcoes_status: [ [ "Todos", "todos" ], [ "Ativos", "ativo" ], [ "Inativos", "inativo" ] ], titulo_filtrar: "Filtrar motoristas" %>

  <%= turbo_frame_tag "motoristas_lista", data: { turbo_action: "advance" } do %>
    <%= render "compartilhado/resumo_tabela", texto: "#{@pagy.count} motorista(s) registrado(s)" %>

    <div class="overflow-x-auto">
      <table class="collection-table min-w-[980px]">
        <thead>
          <tr>
            <th scope="col">Motorista</th>
            <th scope="col">CPF</th>
            <th scope="col">CNH</th>
            <th scope="col">Validade da CNH</th>
            <th scope="col">Status</th>
            <th scope="col">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% @motoristas.each do |motorista| %>
            <tr id="<%= dom_id(motorista) %>">
              <td>
                <p class="text-sm font-semibold text-[var(--text-primary)]"><%= motorista.nome %></p>
                <p class="mt-1 text-xs text-[var(--text-muted)]"><%= motorista.user.email %></p>
              </td>
              <td class="whitespace-nowrap"><%= Cpf.formatar(motorista.cpf) %></td>
              <td><%= motorista.cnh_numero %> · <%= motorista.cnh_categoria %></td>
              <td class="whitespace-nowrap">
                <%= l(motorista.cnh_validade) %>
                <% if motorista.cnh_vencida? %><%= render "compartilhado/selo", texto: "Vencida", tom: :atencao %><% end %>
              </td>
              <td><%= render "compartilhado/selo", texto: (motorista.ativo? ? "Ativo" : "Inativo"), tom: (motorista.ativo? ? :sucesso : :atencao) %></td>
              <td>
                <div class="flex flex-nowrap items-center gap-2">
                  <%= render "compartilhado/botao_acao", titulo: "Editar motorista", icone: :pencil, caminho: edit_transporte_motorista_path(motorista), quadro: "painel" %>
                  <% if motorista.ativo? %>
                    <%= render "compartilhado/botao_acao", titulo: "Desativar motorista", icone: :ban, caminho: desativar_transporte_motorista_path(motorista), metodo: :patch,
                          confirmar: { mensagem: "Confirme a desativação. O registro deixa de aparecer nas opções, mas continua no histórico.", rotulo: "Desativar" } %>
                  <% else %>
                    <%= render "compartilhado/botao_acao", titulo: "Ativar motorista", icone: :check_circle, caminho: ativar_transporte_motorista_path(motorista), metodo: :patch,
                          confirmar: { mensagem: "Confirme a ativação.", rotulo: "Ativar", tom: "primario" } %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
          <% if @motoristas.empty? %>
            <tr><td colspan="6" class="px-6 py-10 text-center text-sm text-[var(--text-secondary)]">Nenhum registro encontrado para os filtros informados.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render "compartilhado/paginacao", pagy: @pagy, quadro: "motoristas_lista" %>
  <% end %>
</section>
