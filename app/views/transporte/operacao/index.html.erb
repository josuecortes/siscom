<% content_for :title, "Operação de transporte" %>

<%= render layout: "compartilhado/cabecalho_pagina", locals: { titulo: "Operação de transporte", icone: :car_alt, migalha: [ "Transporte", transporte_operacao_index_path ] } do %>
  <%= render "compartilhado/acao_cabecalho", rotulo: "Abrir para outra pessoa", icone: :user_follow, caminho: new_transporte_solicitacao_para_outro_path %>
<% end %>

<%= turbo_stream_from "transporte_operacao" %>
<% filtrando = @filtros[:filtrando] %>
<% de_busca = !filtrando && @filtros[:status] == "busca" %>
<% campo = "h-11 w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] text-sm text-[var(--text-primary)] outline-none focus:border-[var(--accent-strong)]" %>
<% rotulo = "text-sm font-medium text-[var(--text-secondary)]" %>
<% data = { controller: "mascara", mascara_tipo_value: "data", action: "input->mascara#aplicar" } %>
<% campo_de_data = ->(nome, texto) do %>
  <div class="space-y-1.5">
    <label for="<%= nome %>" class="<%= rotulo %>"><%= texto %></label>
    <%= text_field_tag nome, DataBr.formatar(@filtros[nome]), placeholder: "dd/mm/aaaa", inputmode: "numeric", maxlength: 10, autocomplete: "off", data: data, class: "#{campo} px-4" %>
  </div>
<% end %>
<section class="mt-6 rounded-[var(--radius-panel)] border border-[var(--border-subtle)] bg-[var(--surface-card)] shadow-[var(--shadow-card)]">
  <%# Qualquer filtro preenchido troca as abas por uma só, "Resultado", com todas as etapas (a etapa vira coluna).
      A ordem não é filtro: vale também nas abas. "Limpar filtros" devolve as abas. %>
  <%= form_with url: transporte_operacao_index_path, method: :get, class: "border-b border-[var(--border-subtle)] px-6 py-5",
        data: { controller: "filtro", turbo_frame: "operacao_lista", turbo_action: "advance" } do |f| %>
    <%= hidden_field_tag :status, @filtros[:status], id: nil %>
    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4 xl:items-end">
      <div class="space-y-1.5 md:col-span-2">
        <%= f.label :q, "Buscar por código, resumo ou solicitante", class: rotulo %>
        <div class="relative">
          <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-[var(--text-muted)]"><%= icone(:search) %></span>
          <%= f.text_field :q, value: @filtros[:q], placeholder: "Ex.: TR-000001 ou Maria", autocomplete: "off", data: { action: "input->filtro#digitar" }, class: "#{campo} pl-11 pr-4" %>
        </div>
      </div>
      <div class="space-y-1.5">
        <%= f.label :tipo, "Tipo", class: rotulo %>
        <%= f.select :tipo, [ [ "Todos", "" ] ] + Transporte::Solicitacao::TIPOS.invert.to_a, { selected: @filtros[:tipo] }, data: { action: "change->filtro#aplicar" }, class: "#{campo} px-4" %>
      </div>
      <%= render "compartilhado/campo_autocomplete", nome: "unidade", id: "filtro_unidade", rotulo: "Unidade de quem pediu", flutuante: true,
            opcoes: @unidades.map { |nome| { valor: nome, rotulo: nome } }, valor: @filtros[:unidade], texto: @filtros[:unidade],
            acao: "change->filtro#aplicar", placeholder: "Todas", vazio: "Nenhuma unidade nas solicitações." %>
      <% campo_de_data.call(:pedido_de, "Pedido de") %>
      <% campo_de_data.call(:pedido_ate, "Pedido até") %>
      <% campo_de_data.call(:saida_de, "Saída de") %>
      <% campo_de_data.call(:saida_ate, "Saída até") %>
      <div class="space-y-1.5 md:col-span-2 xl:col-span-3">
        <%= f.label :ordem, "Ordenar por", class: rotulo %>
        <%= f.select :ordem, [ [ "Data de saída (quem sai primeiro)", "saida" ], [ "Data do pedido (quem pediu primeiro)", "pedido" ] ], { selected: @filtros[:ordem] },
              data: { action: "change->filtro#aplicar" }, class: "#{campo} px-4 xl:max-w-sm" %>
      </div>
      <div class="flex flex-row gap-2 xl:justify-end">
        <button type="submit" title="Filtrar solicitações" aria-label="Filtrar solicitações"
                class="inline-flex h-11 w-11 cursor-pointer items-center justify-center rounded-xl bg-[var(--accent-strong)] text-white hover:bg-[var(--accent-stronger)]"><%= icone(:search) %></button>
        <%= link_to transporte_operacao_index_path, title: "Limpar filtros", aria: { label: "Limpar filtros" },
              class: "inline-flex h-11 w-11 items-center justify-center rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] text-[var(--text-secondary)] hover:border-[var(--accent-strong)]" do %>
          <%= icone(:x) %>
        <% end %>
      </div>
    </div>
  <% end %>

  <%= turbo_frame_tag "operacao_lista", data: { turbo_action: "advance" } do %>
    <% aba = "group inline-flex min-w-fit items-center gap-2 border-b-2 border-transparent px-3 py-3 text-sm font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] aria-[current]:border-[var(--accent-strong)] aria-[current]:text-[var(--text-primary)]" %>
    <% contador = "inline-flex min-w-[1.75rem] items-center justify-center rounded-full bg-[var(--surface-panel)] px-2 py-0.5 text-[11px] font-semibold text-[var(--text-muted)] group-aria-[current]:bg-[var(--accent-soft)] group-aria-[current]:text-[var(--accent-strong)]" %>
    <nav class="border-b border-[var(--border-subtle)] px-4 sm:px-6" aria-label="Etapas das solicitações">
      <div class="flex gap-1 overflow-x-auto [scrollbar-width:none]">
        <% if filtrando %>
          <span class="<%= aba %>" aria-current="page"><span>Resultado</span> <span class="<%= contador %>"><%= @pagy.count %></span></span>
        <% else %>
          <% Transporte::OperacaoController::ABAS.each do |chave, titulo| %>
            <%= link_to transporte_operacao_index_path(status: chave, ordem: (@filtros[:ordem] unless @filtros[:ordem] == "saida")), aria: { current: (chave == @filtros[:status] ? "page" : nil) }, class: aba do %>
              <span><%= titulo %></span>
              <span class="<%= contador %>"><%= @contagens.fetch(chave, 0) %></span>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </nav>
    <% ordem = Transporte::OperacaoController::ORDENS.fetch(@filtros[:ordem]).first.downcase %>
    <%= render "compartilhado/resumo_tabela", texto: (filtrando ? "#{@pagy.count} solicitação(ões) encontrada(s), de todas as etapas, por #{ordem}" : "#{@pagy.count} solicitação(ões) em #{Transporte::OperacaoController::ABAS.fetch(@filtros[:status]).downcase}, por #{ordem}") %>

    <div class="overflow-x-auto">
      <table class="collection-table min-w-[980px]">
        <thead>
          <tr>
            <th scope="col">Código</th>
            <th scope="col">Resumo</th>
            <th scope="col">Solicitante</th>
            <th scope="col">Pedido em</th>
            <th scope="col"><%= de_busca ? "Buscar até" : "Saída" %></th>
            <th scope="col">Destino</th>
            <% if filtrando %><th scope="col">Etapa</th><% end %>
            <th scope="col" class="!pl-2">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% @solicitacoes.each do |solicitacao| %>
            <tr id="<%= dom_id(solicitacao) %>">
              <td class="whitespace-nowrap font-semibold text-[var(--text-primary)]">
                <%= link_to solicitacao.codigo, transporte_operacao_path(solicitacao), class: "hover:text-[var(--accent-strong)]", data: { turbo_frame: "painel" } %>
                <p class="mt-1.5"><%= selo_do_tipo(solicitacao) %></p>
              </td>
              <td class="!whitespace-normal">
                <p class="font-semibold text-[var(--text-primary)]"><%= truncate(solicitacao.resumo, length: 80) %></p>
                <p class="mt-1 text-sm text-[var(--text-secondary)]"><%= solicitacao.nome_do_modo %></p>
              </td>
              <td class="!whitespace-normal"><%# nome e unidade quebram a linha: as ações têm de caber sem rolagem %>
                <p class="text-sm text-[var(--text-primary)]"><%= solicitacao.solicitante_nome %></p>
                <% if solicitacao.unidade_nome.present? %><p class="mt-1 text-xs text-[var(--text-muted)]"><%= solicitacao.unidade_nome %></p><% end %>
              </td>
              <td class="whitespace-nowrap"><%= data_e_hora(solicitacao.created_at) %></td>
              <td class="whitespace-nowrap">
                <% if de_busca %>
                  <%# Como no seed: na aba de busca a coluna mostra até quando buscar, com o selo "Atrasada". %>
                  <div class="space-y-1">
                    <p><%= data_e_hora(solicitacao.busca_prevista_em) || "Não definido" %></p>
                    <% if solicitacao.busca_prevista_em&.past? %>
                      <span class="inline-flex rounded-full border border-[var(--danger-border-strong)] bg-[var(--danger-surface)] px-2 py-0.5 text-[11px] font-semibold text-[var(--danger-text)]">Atrasada</span>
                    <% end %>
                  </div>
                <% else %>
                  <%= data_e_hora(solicitacao.saida_em) %>
                <% end %>
              </td>
              <td class="!whitespace-normal"><%= solicitacao.destinos.first&.nome %><%= " (+#{solicitacao.destinos.size - 1})" if solicitacao.destinos.size > 1 %></td>
              <% if filtrando %><td><%= selo_da_solicitacao(solicitacao) %></td><% end %>
              <td class="!pl-2 !pr-4"><%= render "transporte/solicitacoes/acoes", solicitacao: solicitacao, visao: :operacao %></td>
            </tr>
          <% end %>
          <% if @solicitacoes.empty? %>
            <tr><td colspan="8" class="px-6 py-10 text-center text-sm text-[var(--text-secondary)]">Nenhuma solicitação encontrada para os filtros atuais.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render "compartilhado/paginacao", pagy: @pagy, quadro: "operacao_lista" %>
  <% end %>
</section>
