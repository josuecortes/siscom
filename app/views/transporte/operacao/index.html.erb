<% content_for :title, "Operação de transporte" %>

<%= render layout: "compartilhado/cabecalho_pagina", locals: { titulo: "Operação de transporte", icone: :car_alt, migalha: [ "Transporte", transporte_operacao_index_path ] } do %>
  <%# Abrir para si é pela Minha área; aqui, só em nome de outra pessoa (e só a operação). %>
  <% if @opera %>
    <%= render "compartilhado/acao_cabecalho", rotulo: "Abrir para outra pessoa", icone: :user_follow, caminho: new_transporte_solicitacao_para_outro_path, opcoes: { data: { turbo_frame: "painel" } } %>
  <% end %>
<% end %>

<%= turbo_stream_from "transporte_operacao" %>
<% filtrando = @filtros[:filtrando] %>
<% de_busca = !filtrando && @filtros[:status] == "busca" %>
<% campo = "h-11 w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] text-sm text-[var(--text-primary)] outline-none focus:border-[var(--accent-strong)]" %>
<% rotulo = "text-sm font-medium text-[var(--text-secondary)]" %>
<% data = { controller: "mascara", mascara_tipo_value: "data", action: "input->mascara#aplicar" } %>
<% campo_de_data = ->(nome, texto) do %>
  <div class="space-y-1.5">
    <label for="<%= nome %>" class="<%= rotulo %>"><%= texto %></label>
    <%= text_field_tag nome, DataBr.formatar(@filtros[nome]), placeholder: "dd/mm/aaaa", inputmode: "numeric", maxlength: 10, autocomplete: "off", data: data, class: "#{campo} px-4" %>
  </div>
<% end %>
<section class="mt-6 rounded-[var(--radius-panel)] border border-[var(--border-subtle)] bg-[var(--surface-card)] shadow-[var(--shadow-card)]">
  <%# Qualquer filtro preenchido troca as abas por uma só, "Resultado", com todas as etapas (a etapa vira coluna).
      A ordem não é filtro: vale também nas abas. "Limpar filtros" devolve as abas. %>
  <%= form_with url: transporte_operacao_index_path, method: :get, id: "filtros_da_operacao", class: "border-b border-[var(--border-subtle)] px-6 py-5",
        data: { controller: "filtro", turbo_frame: "operacao_lista", turbo_action: "advance" } do |f| %>
    <% extras = @filtros.slice(:tipo, :unidade_id, :pedido_de, :pedido_ate, :saida_de, :saida_ate).values.count(&:present?) %>
    <%# No celular só a busca fica à vista; os outros campos recolhem atrás de "Mais filtros" (a partir de md aparecem sempre). %>
    <div class="space-y-4" data-controller="recolher">
      <div class="flex items-end gap-2">
        <div class="min-w-0 flex-1 space-y-1.5">
          <%# No celular o rótulo fica só para leitor de tela (o exemplo dentro do campo já explica), para a área ocupar menos. %>
          <%= f.label :q, "Buscar por código, resumo ou solicitante", class: "sr-only md:not-sr-only #{rotulo}" %>
          <div class="relative">
            <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-[var(--text-muted)]"><%= icone(:search) %></span>
            <%= f.text_field :q, value: @filtros[:q], placeholder: "Código, resumo ou solicitante", autocomplete: "off", data: { action: "input->filtro#digitar" }, class: "#{campo} pl-11 pr-4" %>
          </div>
        </div>
        <button type="submit" title="Filtrar solicitações" aria-label="Filtrar solicitações"
                class="inline-flex h-11 w-11 shrink-0 cursor-pointer items-center justify-center rounded-xl bg-[var(--accent-strong)] text-white hover:bg-[var(--accent-stronger)]"><%= icone(:search) %></button>
        <%= link_to transporte_operacao_index_path, title: "Limpar filtros", aria: { label: "Limpar filtros" },
              class: "inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] text-[var(--text-secondary)] hover:border-[var(--accent-strong)]" do %>
          <%= icone(:x) %>
        <% end %>
      </div>
      <button type="button" data-recolher-target="botao" data-action="recolher#alternar" aria-expanded="false" aria-controls="mais_filtros"
              class="group inline-flex h-10 w-full cursor-pointer items-center justify-between gap-2 rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] px-4 text-sm font-semibold text-[var(--text-primary)] md:hidden">
        <span class="inline-flex items-center gap-2">
          Mais filtros
          <% if extras.positive? %><span class="inline-flex min-w-[1.5rem] items-center justify-center rounded-full bg-[var(--accent-soft)] px-2 py-0.5 text-[11px] text-[var(--accent-strong)]"><%= extras %></span><% end %>
        </span>
        <span class="text-[var(--text-secondary)] transition-transform group-aria-expanded:rotate-180"><%= icone(:chevron_right, classe: "h-4 w-4 rotate-90") %></span>
      </button>
      <div id="mais_filtros" data-recolher-target="bloco" class="hidden gap-4 md:grid md:grid-cols-3 xl:grid-cols-6 xl:items-end">
        <div class="mb-4 space-y-1.5 md:mb-0">
          <%= f.label :tipo, "Tipo", class: rotulo %>
          <%= f.select :tipo, [ [ "Todos", "" ] ] + Transporte::Solicitacao::TIPOS.invert.to_a, { selected: @filtros[:tipo] }, data: { action: "change->filtro#aplicar" }, class: "#{campo} px-4" %>
        </div>
        <div class="mb-4 md:mb-0">
          <%# Campo de busca padrão (com 3 letras filtra; se nada combina, lista em ordem alfabética), com as unidades do RH. %>
          <%= render "compartilhado/campo_autocomplete", nome: "unidade_id", id: "filtro_unidade", rotulo: "Unidade de quem pediu", flutuante: true,
                url: transporte_opcoes_de_unidades_path, valor: @filtros[:unidade_id], texto: @unidade&.sigla_e_nome,
                acao: "change->filtro#aplicar", placeholder: "Digite para buscar a unidade", vazio: "Nenhuma unidade cadastrada." %>
        </div>
        <div class="mb-4 grid grid-cols-2 gap-4 md:contents">
          <% campo_de_data.call(:pedido_de, "Pedido de") %>
          <% campo_de_data.call(:pedido_ate, "Pedido até") %>
        </div>
        <div class="grid grid-cols-2 gap-4 md:contents">
          <% campo_de_data.call(:saida_de, "Saída de") %>
          <% campo_de_data.call(:saida_ate, "Saída até") %>
        </div>
      </div>
    </div>
  <% end %>

  <%= turbo_frame_tag "operacao_lista", data: { turbo_action: "advance" } do %>
    <%# A aba e a ordem em uso acompanham os filtros: os campos ficam aqui (dentro do quadro, sempre atuais) e pertencem ao formulário de cima. %>
    <% { status: @filtros[:status], ordem: @filtros[:ordem], direcao: @filtros[:direcao] }.each do |nome, valor| %>
      <%= hidden_field_tag nome, valor, id: nil, form: "filtros_da_operacao" %>
    <% end %>
    <% aba = "group inline-flex min-w-fit items-center gap-2 border-b-2 border-transparent px-3 py-3 text-sm font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] aria-[current]:border-[var(--accent-strong)] aria-[current]:text-[var(--text-primary)]" %>
    <% contador = "inline-flex min-w-[1.75rem] items-center justify-center rounded-full bg-[var(--surface-panel)] px-2 py-0.5 text-[11px] font-semibold text-[var(--text-muted)] group-aria-[current]:bg-[var(--accent-soft)] group-aria-[current]:text-[var(--accent-strong)]" %>
    <nav class="border-b border-[var(--border-subtle)] px-4 sm:px-6" aria-label="Etapas das solicitações">
      <div class="flex gap-1 overflow-x-auto [scrollbar-width:none]">
        <% if filtrando %>
          <span class="<%= aba %>" aria-current="page"><span>Resultado</span> <span class="<%= contador %>"><%= @pagy.count %></span></span>
        <% else %>
          <% @abas.each do |chave, titulo| %>
            <%= link_to transporte_operacao_index_path(status: chave, ordem: (@filtros[:ordem] unless @filtros[:ordem] == "saida"), direcao: (@filtros[:direcao] unless @filtros[:direcao] == "asc")), aria: { current: (chave == @filtros[:status] ? "page" : nil) }, class: aba do %>
              <span><%= titulo %></span>
              <span class="<%= contador %>"><%= @contagens.fetch(chave, 0) %></span>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </nav>
    <% ordem = "#{@filtros[:ordem] == 'pedido' ? 'data do pedido' : (de_busca ? 'hora da busca' : 'data de saída')}, #{@filtros[:direcao] == 'asc' ? 'da mais antiga para a mais nova' : 'da mais nova para a mais antiga'}" %>
    <%# Cabeçalho de coluna de data: clicar ordena por ela; clicar de novo inverte. A seta mostra a ordem em uso. %>
    <% ordenavel = ->(titulo, chave) do %>
      <% ativa = @filtros[:ordem] == chave %>
      <% proxima = ativa && @filtros[:direcao] == "asc" ? "desc" : "asc" %>
      <th scope="col" aria-sort="<%= ativa ? (@filtros[:direcao] == "asc" ? "ascending" : "descending") : "none" %>">
        <%= link_to url_for(request.query_parameters.except("page").merge(ordem: chave, direcao: proxima)),
              title: "Ordenar por #{titulo.downcase} (#{proxima == 'asc' ? 'mais antiga primeiro' : 'mais nova primeiro'})",
              class: "inline-flex items-center gap-1.5 hover:text-[var(--accent-strong)] #{'text-[var(--accent-strong)]' if ativa}" do %>
          <span><%= titulo %></span>
          <span class="text-xs leading-none <%= "opacity-40" unless ativa %>" aria-hidden="true"><%= ativa ? (@filtros[:direcao] == "asc" ? "▲" : "▼") : "▲▼" %></span>
        <% end %>
      </th>
    <% end %>
    <%= render "compartilhado/resumo_tabela", texto: (filtrando ? "#{@pagy.count} solicitação(ões) encontrada(s), de todas as etapas, por #{ordem}" : "#{@pagy.count} solicitação(ões) em #{@abas.fetch(@filtros[:status]).downcase}, por #{ordem}") %>

    <div class="overflow-x-auto">
      <table class="collection-table min-w-[980px]">
        <thead>
          <tr>
            <th scope="col">Código</th>
            <th scope="col">Resumo</th>
            <th scope="col">Solicitante</th>
            <% ordenavel.call("Pedido em", "pedido") %>
            <% ordenavel.call((de_busca ? "Buscar até" : "Saída"), "saida") %>
            <th scope="col">Destino</th>
            <% if filtrando %><th scope="col">Etapa</th><% end %>
            <th scope="col" class="!pl-2">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% @solicitacoes.each do |solicitacao| %>
            <tr id="<%= dom_id(solicitacao) %>">
              <td class="whitespace-nowrap font-semibold text-[var(--text-primary)]">
                <%= link_to solicitacao.codigo, transporte_operacao_path(solicitacao), class: "hover:text-[var(--accent-strong)]", data: { turbo_frame: "painel" } %>
                <p class="mt-1.5"><%= selo_do_tipo(solicitacao) %></p>
              </td>
              <td class="!whitespace-normal">
                <p class="font-semibold text-[var(--text-primary)]"><%= truncate(solicitacao.resumo, length: 80) %></p>
                <p class="mt-1 text-sm text-[var(--text-secondary)]"><%= solicitacao.nome_do_modo %></p>
              </td>
              <td class="!whitespace-normal"><%# nome e unidade quebram a linha: as ações têm de caber sem rolagem %>
                <p class="text-sm text-[var(--text-primary)]"><%= solicitacao.solicitante_nome %></p>
                <% if solicitacao.unidade_nome.present? %><p class="mt-1 text-xs text-[var(--text-muted)]"><%= solicitacao.unidade_nome %></p><% end %>
              </td>
              <td class="whitespace-nowrap"><%= data_e_hora(solicitacao.created_at) %></td>
              <td class="whitespace-nowrap">
                <% if de_busca %>
                  <%# Como no seed: na aba de busca a coluna mostra até quando buscar, com o selo "Atrasada". %>
                  <div class="space-y-1">
                    <p><%= data_e_hora(solicitacao.busca_prevista_em) || "Não definido" %></p>
                    <% if solicitacao.busca_prevista_em&.past? %>
                      <span class="inline-flex rounded-full border border-[var(--danger-border-strong)] bg-[var(--danger-surface)] px-2 py-0.5 text-[11px] font-semibold text-[var(--danger-text)]">Atrasada</span>
                    <% end %>
                  </div>
                <% else %>
                  <%= data_e_hora(solicitacao.saida_em) %>
                <% end %>
              </td>
              <td class="!whitespace-normal"><%= solicitacao.destinos.first&.nome %><%= " (+#{solicitacao.destinos.size - 1})" if solicitacao.destinos.size > 1 %></td>
              <% if filtrando %><td><%= selo_da_solicitacao(solicitacao) %></td><% end %>
              <td class="!pl-2 !pr-4"><%= render "transporte/solicitacoes/acoes", solicitacao: solicitacao, visao: :operacao %></td>
            </tr>
          <% end %>
          <% if @solicitacoes.empty? %>
            <tr><td colspan="8" class="px-6 py-10 text-center text-sm text-[var(--text-secondary)]">Nenhuma solicitação encontrada para os filtros atuais.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render "compartilhado/paginacao", pagy: @pagy, quadro: "operacao_lista" %>
  <% end %>
</section>
