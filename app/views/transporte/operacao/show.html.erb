<% content_for :title, @solicitacao.codigo %>
<% s = @solicitacao %>
<% botao = "inline-flex h-10 cursor-pointer items-center gap-2 rounded-md border border-[var(--border-subtle)] bg-[var(--surface-card)] px-4 text-sm font-medium text-[var(--text-primary)] hover:border-[var(--accent-strong)] hover:text-[var(--accent-strong)]" %>

<%= render layout: "compartilhado/cabecalho_pagina", locals: { titulo: "Solicitação #{s.codigo}", icone: :car_alt, migalha: [ "Operação", transporte_operacao_index_path ] } do %>
  <%= render "compartilhado/acao_cabecalho", rotulo: "Voltar", caminho: transporte_operacao_index_path(status: s.status), secundaria: true %>
<% end %>

<%= turbo_stream_from s %>
<%= render layout: "transporte/solicitacoes/detalhes", locals: { solicitacao: s, observacoes: true } do %>
  <% if s.em_andamento? %>
    <section class="rounded-[var(--radius-panel)] border border-[var(--border-subtle)] bg-[var(--surface-card)] px-6 py-5 shadow-[var(--shadow-card)]" id="acoes_da_solicitacao">
      <h2 class="text-sm font-semibold text-[var(--text-primary)]">O que fazer</h2>
      <div class="mt-3 flex flex-wrap gap-2">
        <% if s.solicitada? && pode?("transporte.solicitacoes.aprovar") %>
          <%= button_to aprovar_transporte_operacao_path(s), method: :patch, form: { data: { turbo_frame: "_top" } },
                class: "inline-flex h-10 cursor-pointer items-center gap-2 rounded-md bg-[var(--accent-strong)] px-4 text-sm font-semibold text-white hover:bg-[var(--accent-stronger)]" do %><%= icone(:check_circle) %> Aprovar solicitação<% end %>
        <% end %>
        <% if s.solicitada? || s.aprovada? || s.busca? %>
          <%= link_to reagendamento_transporte_operacao_path(s), class: botao, data: { turbo_frame: "painel" } do %><%= icone(:clock) %> <%= s.busca? ? "Reagendar busca" : "Reagendar" %><% end %>
        <% end %>
        <%= link_to new_transporte_solicitacao_observacao_path(s), class: botao, data: { turbo_frame: "painel" } do %><%= icone(:notes) %> Registrar observação<% end %>
        <% if pode?("transporte.solicitacoes.aprovar") %>
          <%= link_to cancelamento_transporte_operacao_path(s), class: botao, data: { turbo_frame: "painel" } do %><%= icone(:ban) %> Cancelar solicitação<% end %>
        <% end %>
      </div>
    </section>
  <% end %>
<% end %>
