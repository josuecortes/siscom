<% content_for :title, "Meus serviços" %>

<%= render layout: "compartilhado/cabecalho_pagina", locals: { titulo: "Meus serviços", icone: :speedometer, migalha: [ "Transporte", transporte_servicos_path ] } do %>
<% end %>

<%= turbo_stream_from "transporte_operacao" %>
<% de_busca = @filtros[:status] == "buscas" %>
<section class="mt-6 rounded-[var(--radius-panel)] border border-[var(--border-subtle)] bg-[var(--surface-card)] shadow-[var(--shadow-card)]">
  <%= turbo_frame_tag "servicos_lista", data: { turbo_action: "advance" } do %>
    <nav class="border-b border-[var(--border-subtle)] px-4 sm:px-6" aria-label="Etapas das solicitações">
      <div class="flex gap-1 overflow-x-auto">
        <% Transporte::ServicosController::ABAS.each do |chave, titulo| %>
          <%= link_to transporte_servicos_path(status: chave), aria: { current: (chave == @filtros[:status] ? "page" : nil) },
                class: "group inline-flex min-w-fit items-center gap-2 border-b-2 border-transparent px-3 py-3 text-sm font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] aria-[current]:border-[var(--accent-strong)] aria-[current]:text-[var(--text-primary)]" do %>
            <span><%= titulo %></span>
            <span class="inline-flex min-w-[1.75rem] items-center justify-center rounded-full bg-[var(--surface-panel)] px-2 py-0.5 text-[11px] font-semibold text-[var(--text-muted)] group-aria-[current]:bg-[var(--accent-soft)] group-aria-[current]:text-[var(--accent-strong)]"><%= @contagens.fetch(chave, 0) %></span>
          <% end %>
        <% end %>
      </div>
    </nav>
    <%= render "compartilhado/resumo_tabela", texto: "#{@pagy.count} solicitação(ões): #{Transporte::ServicosController::ABAS.fetch(@filtros[:status]).downcase}" %>

    <div class="overflow-x-auto">
      <table class="collection-table min-w-[980px]">
        <thead>
          <tr>
            <th scope="col">Código</th>
            <th scope="col">Resumo</th>
            <th scope="col">Solicitante</th>
            <th scope="col"><%= de_busca ? "Buscar até" : "Saída" %></th>
            <th scope="col">Destino</th>
            <th scope="col">Status</th>
            <th scope="col">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% @solicitacoes.each do |solicitacao| %>
            <tr id="<%= dom_id(solicitacao) %>">
              <td class="whitespace-nowrap font-semibold text-[var(--text-primary)]">
                <%= link_to solicitacao.codigo, transporte_servico_path(solicitacao), class: "hover:text-[var(--accent-strong)]", data: { turbo_frame: "_top" } %>
              </td>
              <td>
                <p class="font-semibold text-[var(--text-primary)]"><%= truncate(solicitacao.resumo, length: 80) %></p>
                <p class="mt-1 text-sm text-[var(--text-secondary)]"><%= solicitacao.nome_do_tipo %> · <%= solicitacao.nome_do_modo %></p>
              </td>
              <td>
                <p class="text-sm text-[var(--text-primary)]"><%= solicitacao.solicitante_nome %></p>
                <% if solicitacao.unidade_nome.present? %><p class="mt-1 text-xs text-[var(--text-muted)]"><%= solicitacao.unidade_nome %></p><% end %>
              </td>
              <td class="whitespace-nowrap">
                <% if de_busca %>
                  <%# Como no seed: na aba de busca a coluna mostra até quando buscar, com o selo "Atrasada". %>
                  <div class="space-y-1">
                    <p><%= data_e_hora(solicitacao.busca_prevista_em) || "Não definido" %></p>
                    <% if solicitacao.busca_prevista_em&.past? %>
                      <span class="inline-flex rounded-full border border-[var(--danger-border-strong)] bg-[var(--danger-surface)] px-2 py-0.5 text-[11px] font-semibold text-[var(--danger-text)]">Atrasada</span>
                    <% end %>
                  </div>
                <% else %>
                  <%= data_e_hora(solicitacao.saida_em) %>
                <% end %>
              </td>
              <td><%= solicitacao.destinos.first&.nome %><%= " (+#{solicitacao.destinos.size - 1})" if solicitacao.destinos.size > 1 %></td>
              <td><%= selo_da_solicitacao(solicitacao) %></td>
              <td>
                <div class="flex flex-nowrap items-center gap-2">
                  <%= render "compartilhado/botao_acao", titulo: "Visualizar solicitação", icone: :eye, caminho: transporte_servico_path(solicitacao) %>
                </div>
              </td>
            </tr>
          <% end %>
          <% if @solicitacoes.empty? %>
            <tr><td colspan="7" class="px-6 py-10 text-center text-sm text-[var(--text-secondary)]">Nenhuma solicitação encontrada para os filtros atuais.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render "compartilhado/paginacao", pagy: @pagy, quadro: "servicos_lista" %>
  <% end %>
</section>
