<% content_for :title, "Iniciar serviço" %>
<% rodape = capture { render "compartilhado/rodape_painel", formulario: "formulario_inicio", rotulo: "Iniciar serviço" } %>

<%= render layout: "compartilhado/painel_formulario",
      locals: { sobretitulo: "Transporte", titulo: "Iniciar serviço #{@solicitacao.codigo}", voltar: transporte_servico_path(@solicitacao), rodape: rodape,
                descricao: "Escolha o veículo e informe o odômetro que está no painel agora. Ele não pode ser menor que o último registrado do veículo." } do %>
  <%= form_with url: iniciar_transporte_servico_path(@solicitacao), method: :patch, id: "formulario_inicio", class: "space-y-5" do |f| %>
    <% if @erro.present? %>
      <%= render "compartilhado/faixa_aviso", tom: :erro, embutida: true, mensagem: @erro %>
    <% end %>
    <% veiculo = Transporte::Veiculo.find_by(id: params[:veiculo_id]) %>
    <%= render "compartilhado/campo_autocomplete", nome: "veiculo_id", id: "veiculo", rotulo: "Veículo *", obrigatorio: true, url: veiculos_transporte_servicos_path,
          valor: veiculo&.id, texto: veiculo&.descricao, placeholder: "Digite a placa", vazio: "Nenhum veículo livre no momento." %>
    <div class="space-y-1.5">
      <label for="odometro" class="text-sm font-medium text-[var(--text-secondary)]">Odômetro inicial (km) *</label>
      <%= number_field_tag :odometro, params[:odometro], required: true, min: 0, step: 1, inputmode: "numeric", class: "h-11 w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] px-4 text-sm text-[var(--text-primary)] outline-none placeholder:text-[var(--text-muted)] focus:border-[var(--accent-strong)]" %>
    </div>
    <% if @candidatas.any? %>
      <fieldset class="space-y-2">
        <legend class="mb-1.5 text-sm font-medium text-[var(--text-secondary)]">Levar junto na mesma viagem</legend>
        <p class="text-xs text-[var(--text-muted)]">Opcional. Todos os solicitantes são avisados de que o serviço é compartilhado.</p>
        <% marcadas = Array(params[:outras_ids]).map(&:to_i) %>
        <% @candidatas.each do |outra| %>
          <label class="flex items-start gap-3 rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] px-4 py-3 text-sm">
            <%= check_box_tag "outras_ids[]", outra.id, marcadas.include?(outra.id), id: "outra_#{outra.id}", class: "mt-0.5 h-4 w-4" %>
            <span class="min-w-0">
              <span class="block font-semibold text-[var(--text-primary)]"><%= outra.codigo %> · <%= outra.solicitante_nome %></span>
              <span class="block text-[var(--text-secondary)]"><%= outra.busca? ? "Busca prevista: #{data_e_hora(outra.busca_prevista_em)}" : "Saída: #{data_e_hora(outra.saida_em)}" %> · <%= outra.destinos.map(&:nome).join(", ") %></span>
            </span>
          </label>
        <% end %>
      </fieldset>
    <% end %>
  <% end %>
<% end %>
