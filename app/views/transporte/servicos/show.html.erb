<% content_for :title, @solicitacao.codigo %>
<% s = @solicitacao %>
<% aberto = s.servico_aberto %>

<%= render layout: "compartilhado/cabecalho_pagina", locals: { titulo: "Solicitação #{s.codigo}", icone: :car_alt, migalha: [ "Meus serviços", transporte_servicos_path ] } do %>
  <%= render "compartilhado/acao_cabecalho", rotulo: "Voltar", caminho: transporte_servicos_path, secundaria: true %>
<% end %>

<%= turbo_stream_from s %>
<%= render layout: "transporte/solicitacoes/detalhes", locals: { solicitacao: s, observacoes: true } do %>
  <section class="rounded-[var(--radius-panel)] border border-[var(--border-subtle)] bg-[var(--surface-card)] px-6 py-5 shadow-[var(--shadow-card)]" id="acoes_do_servico">
    <h2 class="text-sm font-semibold text-[var(--text-primary)]">O que fazer</h2>
    <div class="mt-3 flex flex-wrap gap-2">
      <% if s.pode_iniciar_servico? %>
        <%= link_to inicio_transporte_servico_path(s), class: "inline-flex h-10 cursor-pointer items-center gap-2 rounded-md bg-[var(--accent-strong)] px-4 text-sm font-semibold text-white hover:bg-[var(--accent-stronger)]", data: { turbo_frame: "painel" } do %><%= icone(:media_play) %> <%= s.busca? ? "Sair para buscar" : "Iniciar serviço" %><% end %>
      <% elsif aberto && aberto.motorista_id == current_user.id %>
        <%= link_to fim_transporte_servico_path(s), class: "inline-flex h-10 cursor-pointer items-center gap-2 rounded-md bg-[var(--accent-strong)] px-4 text-sm font-semibold text-white hover:bg-[var(--accent-stronger)]", data: { turbo_frame: "painel" } do %><%= icone(:media_stop) %> <%= aberto.de_busca? || !s.buscar_depois? ? "Finalizar serviço" : "Cheguei ao destino" %><% end %>
      <% end %>
      <% if Transporte::Solicitacoes::Observar.papel_de(s, current_user) %>
        <%= link_to new_transporte_solicitacao_observacao_path(s), class: "inline-flex h-10 cursor-pointer items-center gap-2 rounded-md border border-[var(--border-subtle)] bg-[var(--surface-card)] px-4 text-sm font-medium text-[var(--text-primary)] hover:border-[var(--accent-strong)] hover:text-[var(--accent-strong)]", data: { turbo_frame: "painel" } do %><%= icone(:notes) %> Registrar observação<% end %>
      <% end %>
    </div>
    <% if aberto && aberto.motorista_id != current_user.id %>
      <p class="mt-3 text-sm text-[var(--text-secondary)]">Em serviço com <%= aberto.motorista_nome %> (<%= aberto.placa %>).</p>
    <% end %>
  </section>
<% end %>
