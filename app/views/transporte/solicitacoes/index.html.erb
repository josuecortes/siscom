<% content_for :title, "Solicitações de transporte" %>

<%= render layout: "compartilhado/cabecalho_pagina", locals: { titulo: "Solicitações de transporte", icone: :car_alt, migalha: [ "Minha área", transporte_solicitacoes_path ] } do %>
  <%= render "compartilhado/acao_cabecalho", rotulo: "Nova solicitação", icone: :plus, caminho: new_transporte_solicitacao_path, opcoes: { data: { turbo_frame: "painel" } } %>
<% end %>

<%= turbo_stream_from current_user, "transporte_solicitacoes" %>
<section class="mt-6 rounded-[var(--radius-panel)] border border-[var(--border-subtle)] bg-[var(--surface-card)] shadow-[var(--shadow-card)]">
  <%= form_with url: transporte_solicitacoes_path, method: :get, class: "border-b border-[var(--border-subtle)] px-6 py-5",
        data: { controller: "filtro", turbo_frame: "solicitacoes_lista", turbo_action: "advance" } do |f| %>
    <%= hidden_field_tag :status, @filtros[:status], id: nil %>
    <div class="grid gap-4 lg:grid-cols-[1fr_auto] lg:items-end">
      <div class="space-y-1.5">
        <%= f.label :q, "Buscar por código ou resumo", class: "text-sm font-medium text-[var(--text-secondary)]" %>
        <div class="relative">
          <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-[var(--text-muted)]"><%= icone(:search) %></span>
          <%= f.text_field :q, value: @filtros[:q], placeholder: "Ex.: TR-000001 ou reunião", autocomplete: "off", data: { action: "input->filtro#digitar" }, class: "h-11 w-full rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] text-sm outline-none focus:border-[var(--accent-strong)] pl-11 pr-4" %>
        </div>
      </div>
      <div class="flex flex-row gap-2">
        <button type="submit" title="Filtrar solicitações" aria-label="Filtrar solicitações"
                class="inline-flex h-11 w-11 cursor-pointer items-center justify-center rounded-xl bg-[var(--accent-strong)] text-white hover:bg-[var(--accent-stronger)]"><%= icone(:search) %></button>
        <%= link_to transporte_solicitacoes_path, title: "Limpar filtros", aria: { label: "Limpar filtros" },
              class: "inline-flex h-11 w-11 items-center justify-center rounded-xl border border-[var(--border-subtle)] bg-[var(--filter-field-bg)] text-[var(--text-secondary)] hover:border-[var(--accent-strong)]" do %>
          <%= icone(:x) %>
        <% end %>
      </div>
    </div>
  <% end %>

  <%= turbo_frame_tag "solicitacoes_lista", data: { turbo_action: "advance" } do %>
    <nav class="border-b border-[var(--border-subtle)] px-4 sm:px-6" aria-label="Etapas das solicitações">
      <div class="flex gap-1 overflow-x-auto [scrollbar-width:none]">
        <% Transporte::SolicitacoesController::ABAS.each do |chave, (titulo, _)| %>
          <%= link_to transporte_solicitacoes_path(status: chave, q: @filtros[:q].presence), aria: { current: (chave == @filtros[:status] ? "page" : nil) },
                class: "group inline-flex min-w-fit items-center gap-2 border-b-2 border-transparent px-3 py-3 text-sm font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] aria-[current]:border-[var(--accent-strong)] aria-[current]:text-[var(--text-primary)]" do %>
            <span><%= titulo %></span>
            <span class="inline-flex min-w-[1.75rem] items-center justify-center rounded-full bg-[var(--surface-panel)] px-2 py-0.5 text-[11px] font-semibold text-[var(--text-muted)] group-aria-[current]:bg-[var(--accent-soft)] group-aria-[current]:text-[var(--accent-strong)]"><%= @contagens.fetch(chave, 0) %></span>
          <% end %>
        <% end %>
      </div>
    </nav>
    <%= render "compartilhado/resumo_tabela", texto: "#{@pagy.count} solicitação(ões) em #{Transporte::SolicitacoesController::ABAS.dig(@filtros[:status], 0).downcase}" %>

    <div class="overflow-x-auto">
      <table class="collection-table min-w-[980px]">
        <thead>
          <tr>
            <th scope="col">Código</th>
            <th scope="col">Resumo</th>
            <th scope="col">Saída</th>
            <th scope="col">Destino</th>
            <th scope="col">Status</th>
            <th scope="col" class="!pl-2">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% @solicitacoes.each do |solicitacao| %>
            <tr id="<%= dom_id(solicitacao) %>">
              <td class="whitespace-nowrap font-semibold text-[var(--text-primary)]">
                <%= link_to solicitacao.codigo, transporte_solicitacao_path(solicitacao), class: "hover:text-[var(--accent-strong)]", data: { turbo_frame: "painel" } %>
              </td>
              <td>
                <p class="font-semibold text-[var(--text-primary)]"><%= truncate(solicitacao.resumo, length: 80) %></p>
                <p class="mt-1 text-sm text-[var(--text-secondary)]"><%= solicitacao.nome_do_tipo %> · <%= solicitacao.nome_do_modo %></p>
              </td>
              <td class="whitespace-nowrap"><%= data_e_hora(solicitacao.saida_em) %></td>
              <td><%= solicitacao.destinos.first&.nome %><%= " (+#{solicitacao.destinos.size - 1})" if solicitacao.destinos.size > 1 %></td>
              <td><%= selo_da_solicitacao(solicitacao) %></td>
              <td class="!pl-2 !pr-4"><%= render "transporte/solicitacoes/acoes", solicitacao: solicitacao, visao: :solicitante %></td>
            </tr>
          <% end %>
          <% if @solicitacoes.empty? %>
            <tr><td colspan="6" class="px-6 py-10 text-center text-sm text-[var(--text-secondary)]">Nenhuma solicitação encontrada para os filtros atuais.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render "compartilhado/paginacao", pagy: @pagy, quadro: "solicitacoes_lista" %>
  <% end %>
</section>
