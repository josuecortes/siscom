<% content_for :title, @solicitacao.codigo %>
<% s = @solicitacao %>

<%= render layout: "compartilhado/cabecalho_pagina", locals: { titulo: "Solicitação #{s.codigo}", icone: :car_alt, migalha: [ "Solicitações de transporte", transporte_solicitacoes_path ] } do %>
  <%= render "compartilhado/acao_cabecalho", rotulo: "Voltar", caminho: transporte_solicitacoes_path, secundaria: true %>
<% end %>

<%= turbo_stream_from s %>
<%= render layout: "detalhes", locals: { solicitacao: s } do %>
  <% if s.solicitante_id == current_user.id && (s.solicitada? || s.aprovada?) %>
    <section class="rounded-[var(--radius-panel)] border border-[var(--border-subtle)] bg-[var(--surface-card)] px-6 py-5 shadow-[var(--shadow-card)]">
      <h2 class="text-sm font-semibold text-[var(--text-primary)]"><%= s.solicitada? ? "Aguardando a aprovação do setor de transporte" : "Solicitação aprovada" %></h2>
      <p class="mt-1 text-sm text-[var(--text-secondary)]">Se não precisar mais do transporte, cancele para liberar o veículo.</p>
      <div class="mt-3"><%= link_to "Cancelar solicitação", cancelamento_transporte_solicitacao_path(s), data: { turbo_frame: "painel" }, class: "inline-flex h-10 cursor-pointer items-center gap-2 rounded-md border border-[var(--border-subtle)] bg-[var(--surface-card)] px-4 text-sm font-medium text-[var(--text-primary)] hover:border-[var(--accent-strong)] hover:text-[var(--accent-strong)]" %></div>
    </section>
  <% end %>
<% end %>
